<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationReplace">
    <xpath>*/ThingDef[defName="BabyFood"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>MealAwful</li>
      </thingCategories>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>*/ThingDef[defName="HemogenPack"]/thingCategories</xpath>
    <value>
      <thingCategories>
        <li>AnimalProductRaw</li>
      </thingCategories>
    </value>
  </Operation>
  
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/RecipeDef[defName="Make_BabyFood" or defName="Make_BabyFoodBulk"]</xpath>
    <value>
    	  <recipeUsers>
          	<li>FueledStove</li>
          	<li>ElectricStove</li>
          </recipeUsers>
    </value>
  </Operation>
  
</Patch>
