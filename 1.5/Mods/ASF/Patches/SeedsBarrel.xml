<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	
<Operation MayRequire="Evyatar108.SeedsPleaseLiteRedux" Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="Aq_SeedsBarrel"]</xpath>
</Operation>

<Operation MayRequire="Evyatar108.SeedsPleaseLiteRedux" Class="PatchOperationAdd">
				<xpath>Defs</xpath>
				<value>

				<ThingDef ParentName="AdaptiveStorageBase">
					<defName>Aq_SeedsBarrel</defName>
					<label>seeds barrel</label>
					<techLevel>Neolithic</techLevel>
					<description>A barrel that contains a mix of crushed rocks, sand and dirt that can be used to store seeds or other vegetable matter.</description>
					<graphicData>
					  <texPath>Things/Storage/Aq_SeedsBarrel</texPath>
					  <graphicClass>Graphic_Single</graphicClass>
					  <drawSize>(1,1)</drawSize>
					  <drawRotated>false</drawRotated>
					</graphicData>
					<fillPercent>0.20</fillPercent>
					<uiIconScale>1</uiIconScale>
					<size>(1,1)</size>
        			<rotatable>false</rotatable>
					<researchPrerequisites>
					  <li>Pemmican</li>
					</researchPrerequisites>
					<statBases>
					  <WorkToBuild>500</WorkToBuild>
					  <Beauty>-1</Beauty>
					  <Mass>5</Mass>
					  <Flammability>1</Flammability>
					</statBases>
					<costList>
					  <Pemmican>20</Pemmican>
					</costList>
					<costStuffCount>25</costStuffCount>
    				<stuffCategories>
      					<li>Woody</li>
    				</stuffCategories>
					<building>
					  <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
					  <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
					  <maxItemsInCell>5</maxItemsInCell>
					  <defaultStorageSettings>
						<priority>Preferred</priority>
						<filter>
						  <categories>
							<li>SeedsCategory</li>
						  </categories>
						  <thingDefs>
						  	<li MayRequire="Ludeon.Rimworld.Ideology">GauranlenSeed</li>
						  	<li MayRequire="Ludeon.Rimworld.Anomaly">HarbingerSeed</li>
						  </thingDefs>
						</filter>
					  </defaultStorageSettings>
					  <fixedStorageSettings>
						<filter>
						  <categories>
							<li>SeedsCategory</li>
						  </categories>
						  <thingDefs>
						  	<li MayRequire="Ludeon.Rimworld.Ideology">GauranlenSeed</li>
						  	<li MayRequire="Ludeon.Rimworld.Anomaly">HarbingerSeed</li>
						  </thingDefs>
						</filter>
					  </fixedStorageSettings>
					<paintable>true</paintable>
					</building>
					<minifiedDef>MinifiedThing</minifiedDef>
					<thingCategories>
					  <li>BuildingsFurniture</li>
					</thingCategories>
				</ThingDef>
				
				 <AdaptiveStorage.GraphicsDef Name="Aq_SeedsBarrelStorageBase" Abstract="True">
					<targetDef>Aq_SeedsBarrel</targetDef>
        			<graphics>
            			<li>
                			<graphicData>
                    		  <texPath>Things/Storage/Aq_SeedsBarrel</texPath>
                    		  <graphicClass>Graphic_Single</graphicClass>
                    		  <drawSize>(1,1)</drawSize>
                    		  <drawRotated>false</drawRotated>
                			</graphicData>
            			</li>
        			</graphics>
					<showContainedItems>false</showContainedItems>
				</AdaptiveStorage.GraphicsDef>
				
				 <AdaptiveStorage.GraphicsDef ParentName="Aq_SeedsBarrelStorageBase">
					<defName>Aq_SeedsBarrelStorageA</defName>
        			<graphics>
            			<li>
                			<graphicData>
                    		  <texPath>Things/Storage/Aq_SeedsBarrelA</texPath>
                    		  <graphicClass>Graphic_Single</graphicClass>
                    		  <drawSize>(1,1)</drawSize>
                    		  <drawRotated>false</drawRotated>
                			</graphicData>
                			<minimumStackCount>1</minimumStackCount>
            			</li>
        			</graphics>
				</AdaptiveStorage.GraphicsDef>
				
				
				</value>
</Operation>

</Patch>