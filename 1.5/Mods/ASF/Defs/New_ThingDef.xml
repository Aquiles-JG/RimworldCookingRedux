<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="AdaptiveStorageBase">
    <defName>Aq_StoneCellar</defName>
    <label>stone cellar</label>
    <graphicData>
      <texPath>Things/Building/Storage/StoneCellar/StoneCellar</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.55,1.55)</drawSize>
      <drawRotated>false</drawRotated>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <description>A stone cellar stone that can store a range of items. Keeps perishable items cooler underground if loaded with ice blocks. Items stored inside will never deteriorate and don't affect the beauty of their surroundings.</description>
    <researchPrerequisites>
      <li>Aq_IceMaking</li>
    </researchPrerequisites>
    <fillPercent>0.25</fillPercent>
    <uiIconPath>Things/Building/Storage/StoneCellar/StoneCellar_UI</uiIconPath>
    <uiIconScale>1.15</uiIconScale>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <statBases>
      <Beauty>0</Beauty>
      <MaxHitPoints>3000</MaxHitPoints>
      <WorkToBuild>25000</WorkToBuild>
      <Flammability>0.0</Flammability>
      <Mass>8000</Mass>
    </statBases>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>225</costStuffCount>
    <costList>
      <WoodLog>25</WoodLog>
    </costList>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <maxItemsInCell>10</maxItemsInCell>
    </building>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>8</fuelConsumptionRate>
        <fuelCapacity>50</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>Aq_IceBlocks</li>
          </thingDefs>
        </fuelFilter>
        <fuelIconPath>Things/Item/Resource/Aq_NoIceBlocks</fuelIconPath>
        <initialFuelPercent>0</initialFuelPercent>
      </li>
    </comps>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <tradeability>None</tradeability>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <placeWorkers>
      <li>PlaceWorker_NeverAdjacentSameDef</li>
    </placeWorkers>
    <modExtensions>
      <li Class="AdaptiveStorage.Extension">
        <temperature>
          <coolingOffset>12</coolingOffset>
        </temperature>
      </li>
    </modExtensions>
  </ThingDef>
  
  <ThingDef ParentName="AdaptiveStorageBase">
    <defName>Aq_SaltedBarrel</defName>
    <label>salted barrel</label>
    <description>A barrel that contains a mix of salted spices that can be used to store salted meat rations.</description>
    <techLevel>Neolithic</techLevel>
    <graphicData>
      <texPath>Things/Storage/Aq_SaltedBarrel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>
    <fillPercent>0.30</fillPercent>
    <uiIconScale>1</uiIconScale>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <researchPrerequisites>
      <li>Aq_Salting</li>
    </researchPrerequisites>
    <statBases>
      <WorkToBuild>500</WorkToBuild>
      <Beauty>-1</Beauty>
      <Mass>5</Mass>
      <Flammability>1</Flammability>
    </statBases>
    <costList>
      <Aq_Salt>15</Aq_Salt>
    </costList>
    <costStuffCount>25</costStuffCount>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <maxItemsInCell>4</maxItemsInCell>
      <defaultStorageSettings>
        <priority>Preferred</priority>
        <filter>
          <thingDefs>
            <li>Aq_SaltedMeat</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>Aq_SaltedMeat</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <paintable>true</paintable>
    </building>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
  </ThingDef>
</Defs>
