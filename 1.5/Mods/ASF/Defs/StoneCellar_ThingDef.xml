<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ThingDef ParentName="AdaptiveStorageBase">
        <defName>Aq_StoneCellar</defName>
        <label>stone cellar</label>
        <graphicData>
            <texPath>Things/Building/Storage/StoneCellar/StoneCellar</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(1.55,1.55)</drawSize>
            <drawRotated>false</drawRotated>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <description>A stone cellar stone that can store a range of items. Keeps perishable items cooler underground if loaded with ice blocks. Items stored inside will never deteriorate and don't affect the beauty of their surroundings.</description>
        <researchPrerequisites>
            <li>Aq_IceMaking</li>
        </researchPrerequisites>
        <fillPercent>0.25</fillPercent>
        <uiIconPath>Things/Building/Storage/StoneCellar/StoneCellar_UI</uiIconPath>
        <uiIconScale>1.15</uiIconScale>
        <size>(1,1)</size>
        <rotatable>true</rotatable>
        <defaultPlacingRot>South</defaultPlacingRot>
        <statBases>
            <Beauty>0</Beauty>
            <MaxHitPoints>3000</MaxHitPoints>
            <WorkToBuild>25000</WorkToBuild>
            <Flammability>0.0</Flammability>
            <Mass>8000</Mass>
        </statBases>
        <stuffCategories>
            <li>Stony</li>
        </stuffCategories>
        <costStuffCount>225</costStuffCount>
        <costList>
            <WoodLog>25</WoodLog>
        </costList>
        <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
        <building>
            <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
            <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
            <maxItemsInCell>10</maxItemsInCell>
        </building>
		<comps>
			<li Class="CompProperties_Refuelable">
                <fuelConsumptionRate>8</fuelConsumptionRate>
                <fuelCapacity>50</fuelCapacity>
                <fuelFilter>
					<thingDefs>
						<li>Aq_IceBlocks</li>
					</thingDefs>
                </fuelFilter>
                <fuelIconPath>Things/Item/Resource/Aq_NoIceBlocks</fuelIconPath>
				<initialFuelPercent>0</initialFuelPercent>
			</li>
		</comps>
        <tickerType>Normal</tickerType>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsFurniture</li>
        </thingCategories>
        <placeWorkers>
            <li>PlaceWorker_NeverAdjacentSameDef</li>
        </placeWorkers>
		<modExtensions>
			<li Class="AdaptiveStorage.Extension">
          	<temperature>
            	<coolingOffset>11.0</coolingOffset>
            	<coolingMin>-5</coolingMin>
          	</temperature>
        </li>
		</modExtensions>
    </ThingDef>
</Defs>
