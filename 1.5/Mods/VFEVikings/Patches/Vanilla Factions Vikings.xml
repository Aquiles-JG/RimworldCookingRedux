<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	
<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Factions Expanded - Vikings</li>
		</mods>

		<match Class="PatchOperationSequence">
			<operations>
			
			
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/ThingDef[defName="VFEV_Honey"]/label</xpath>
					<value>
						 <label>apiary honeycombs</label>
					</value>
				</li>
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/RecipeDef[defName="VFEV_Make_Sweetroll"]/label</xpath>
					<value>
						 <label>bake sweetrolls</label>
					</value>
				</li>
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/RecipeDef[defName="VFEV_Make_Sweetroll"]/description</xpath>
					<value>
						 <description>Bake sweetrolls out of honey and eggs.</description>
					</value>
				</li>
				<li Class="PatchOperationAdd"> 
					<xpath>/Defs/RecipeDef[defName="VFEV_Make_Sweetroll"]</xpath>
					<value>
						<researchPrerequisite>Aq_HoneyMaking</researchPrerequisite>
					</value>
				</li>
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/RecipeDef[defName="VFEV_Make_Sweetroll"]/recipeUsers</xpath>
					<value>
						 <recipeUsers>
						 	<li>Aq_Oven</li>
						 	<li>Aq_ElectricOven</li>
						 </recipeUsers>
					</value>
				</li>
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/RecipeDef[defName="VFEV_Make_Sweetroll"]/ingredients/li[2]/filter/thingDefs</xpath>
					<value>
						<thingDefs>
						 	<li>Aq_Honey</li>
						</thingDefs>
					</value>
				</li>
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/RecipeDef[defName = "VFEV_Make_Sweetroll"]/fixedIngredientFilter/thingDefs</xpath>
					<value>
						<thingDefs>
						 	<li>Aq_Honey</li>
						</thingDefs>
					</value>
				</li>
				
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/ThingDef[defName="VFEV_Sweetroll"]/ingestible/foodType</xpath>
					<value>
						 <foodType>Meal</foodType>
					</value>
				</li>
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/ThingDef[defName="VFEV_Sweetroll"]/ingestible/preferability</xpath>
					<value>
						 <preferability>MealSimple</preferability>
					</value>
				</li>
				
				<li Class="PatchOperationAdd"> 
					<xpath>/Defs/ItemProcessor.ItemAcceptedDef[defName="VFEV_MeadBarrelFirstItem"]/items</xpath>
					<value>
      						<li>Aq_RawHoney</li>
					</value>
				</li>
				<li Class="PatchOperationAdd"> 
					<xpath>/Defs/ItemProcessor.CombinationDef[defName="VFEV_HoneyToMead"]/items</xpath>
					<value>
      						<li>Aq_RawHoney</li>	
					</value>
				</li>
				
				<li Class="PatchOperationAdd"> 
					<xpath>/Defs/RecipeDef[defName = "Aq_ChurnHoney"]/ingredients/li[1]/filter/thingDefs</xpath>
					<value>
						<li>VFEV_Honey</li>
					</value>
				</li>
				<li Class="PatchOperationAdd"> 
					<xpath>/Defs/RecipeDef[defName = "Aq_ChurnHoney"]/fixedIngredientFilter/thingDefs</xpath>
					<value>
						<li>VFEV_Honey</li>
					</value>
				</li>
				
			
			
			</operations>
		</match>
		
</Operation>
	
</Patch>