          <xpath>/Defs</xpath>
          <value>
            <ThingDef ParentName="SeedBase">
              <defName>Seed_Aq_Cinnamon</defName>
              <label>cinnamon seeds</label>
              <modExtensions>
                <li Class="SeedsPleaseLite.Seed">
                  <sources>
                    <li>Aq_CinnamonTree</li>
                  </sources>
                </li>
              </modExtensions>
              <descriptionHyperlinks>
                <ThingDef>Aq_CinnamonTree</ThingDef>
              </descriptionHyperlinks>
              <graphicData>
                <texPath>Things/Plants/Trees/Seeds/Aq_CinnamonTree</texPath>
