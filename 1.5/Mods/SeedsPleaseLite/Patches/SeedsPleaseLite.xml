<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>SeedsPlease: Lite</li>
      <li>SeedsPlease: Lite Redux</li>
    </mods>
    
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="RawStrawberries"]/thingCategories</xpath>
          <value>
            <thingCategories Inherit="False">
              <li>Aq_Fruit</li>
            </thingCategories>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ProcessorFramework.ProcessDef[defName="HarvestHoney"]/ingredientFilter</xpath>
          <value>
            <disallowedCategories>
              <li>SeedsCategory</li>
            </disallowedCategories>
          </value>
        </li>
        <!-- No need for a ThingCategoryDef like this-->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingCategoryDef[defName="SeedExtractable"]</xpath>
          <value>
            <ThingCategoryDef>
              <defName>SeedExtractable</defName>
              <label>dummy</label>
            </ThingCategoryDef>
          </value>
        </li>
