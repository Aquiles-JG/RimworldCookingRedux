<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName = "Aq_WineBarrel" or defName="Aq_MeadBarrel"]</xpath>
    <value>
      <stuffCategories>
        <li>Woody</li>
      </stuffCategories>
      <costStuffCount>80</costStuffCount>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName = "Aq_SodaBarrel" or defName="Aq_Beehive"]</xpath>
    <value>
      <stuffCategories>
        <li>Woody</li>
      </stuffCategories>
      <costStuffCount>60</costStuffCount>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName = "Aq_Churn" or defName="Aq_CheesePress" or defName="Aq_Presser"]</xpath>
    <value>
      <stuffCategories>
        <li>Woody</li>
      </stuffCategories>
      <costStuffCount>50</costStuffCount>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName = "Aq_MeatRack" or defName="Aq_SausagePost"]</xpath>
    <value>
      <stuffCategories>
        <li>Woody</li>
      </stuffCategories>
      <costStuffCount>30</costStuffCount>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName = "Aq_Churn" or defName="Aq_CheesePress" or defName="Aq_Presser" or defName="Aq_MeatRack" or defName="Aq_SausagePost" or defName="Aq_SodaBarrel" or defName="Aq_WineBarrel" or defName="Aq_MeadBarrel" or defName="Aq_Beehive"]/constructEffect</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName = "Aq_Churn" or defName="Aq_CheesePress" or defName="Aq_Presser" or defName="Aq_MeatRack" or defName="Aq_SausagePost" or defName="Aq_SodaBarrel" or defName="Aq_WineBarrel" or defName="Aq_MeadBarrel" or defName="Aq_Beehive"]/costList/WoodLog</xpath>
  </Operation>
  
</Patch>
