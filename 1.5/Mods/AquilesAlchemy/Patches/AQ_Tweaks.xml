<?xml version="1.0" encoding="utf-8"?>
<Patch>
 
  <Operation Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Aq_Oven" or defName="Aq_Grill"]/comps/li[@Class="CompProperties_Refuelable"]/fuelFilter/thingDefs</xpath>
          <value>
            <li>Aq_Coal</li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="Aq_MeadBarrel"]/costList/Steel</xpath>
          <value>
            <Aq_Iron>20</Aq_Iron>
          </value>
        </li>
         <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="Aq_CheesePress"]/costList/Steel</xpath>
          <value>
            <Aq_Iron>10</Aq_Iron>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ProcessorFramework.ProcessDef[defName="HarvestHoney"]/ingredientFilter/disallowedThingDefs</xpath>
          <value>
            <li>Aq_PlantFiber</li>
            <li>Aq_DragoBlood</li>
            <li>Aq_Liquidamber</li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="Aq_MeatRack" or defName="Aq_SausagePost"]/costList</xpath>
          <value>
            <Aq_Rope>1</Aq_Rope>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="Aq_CheesePress"]/costList</xpath>
          <value>
            <Aq_PrimitiveComponent>1</Aq_PrimitiveComponent>
          </value>
        </li>
      </operations>
  </Operation>
  
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName = "Aq_MakeIceBlocks" or defName="Aq_MakeIceBlocksBulk"]/ingredients/li/filter/thingDefs</xpath>
    <value>
      <li>Aq_PlantScraps</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName = "Aq_MakeIceBlocks" or defName="Aq_MakeIceBlocksBulk"]/defaultIngredientFilter/thingDefs</xpath>
    <value>
      <li>Aq_PlantScraps</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName = "Aq_MakeIceBlocks" or defName="Aq_MakeIceBlocksBulk"]/fixedIngredientFilter/thingDefs</xpath>
    <value>
      <li>Aq_PlantScraps</li>
    </value>
  </Operation>
  
  <!-- Fat for Sausages-->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/RecipeDef[defName = "Aq_GrillSausages"]/ingredients</xpath>
    <value>
      <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Sausage_Raw</li>
          </thingDefs>
        </filter>
        <count>1.8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_Fat</li>
          </thingDefs>
        </filter>
        <count>0.2</count>
      </li>
      </ingredients>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName = "Aq_GrillSausages"]/defaultIngredientFilter/thingDefs</xpath>
    <value>
      <li>Aq_Fat</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/RecipeDef[defName = "Aq_GrillSausages"]/fixedIngredientFilter/thingDefs</xpath>
    <value>
      <li>Aq_Fat</li>
    </value>
  </Operation>
  
</Patch>
