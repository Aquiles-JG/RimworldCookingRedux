<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="ASF_CellarStone" or defName="ASF_CellarWood" or defName="ASF_StoragePit"]/comps/li[@Class="CompProperties_Refuelable"]/fuelFilter/thingDefs/li[text()="WoodLog"]</xpath>
    <value>
      <li>Aq_IceBlocks</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="ASF_CellarStone"]/researchPrerequisites</xpath>
    <value>
      <researchPrerequisites>
        <li>Aq_IceMaking</li>
      </researchPrerequisites>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="ASF_CellarWood"]</xpath>
    <value>
      <researchPrerequisites>
        <li>Aq_IceMaking</li>
      </researchPrerequisites>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="ASF_StoragePit"]/comps/li[@Class="CompProperties_Refuelable"]/fuelConsumptionRate</xpath>
    <value>
      <fuelConsumptionRate>10</fuelConsumptionRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="ASF_CellarWood"]/comps/li[@Class="CompProperties_Refuelable"]/fuelConsumptionRate</xpath>
    <value>
      <fuelConsumptionRate>8.5</fuelConsumptionRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="ASF_CellarStone"]/comps/li[@Class="CompProperties_Refuelable"]/fuelConsumptionRate</xpath>
    <value>
      <fuelConsumptionRate>8</fuelConsumptionRate>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="ASF_StoragePit"]/comps/li[@Class="CompProperties_Refuelable"]/fuelCapacity</xpath>
    <value>
      <fuelCapacity>40</fuelCapacity>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="ASF_CellarStone" or defName="ASF_CellarWood"]/comps/li[@Class="CompProperties_Refuelable"]/fuelCapacity</xpath>
    <value>
      <fuelCapacity>50</fuelCapacity>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="ASF_CellarStone" or defName="ASF_CellarWood" or defName="ASF_StoragePit"]/modExtensions</xpath>
    <value>
      <modExtensions>
        <li Class="AdaptiveStorage.Extension">
          <temperature>
            <coolingOffset>-11.0</coolingOffset>
            <coolingMin>-5</coolingMin>
          </temperature>
        </li>
      </modExtensions>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="ASF_CellarStone" or defName="ASF_CellarWood" or defName="ASF_StoragePit"]/comps/li[@Class="CompProperties_Refuelable"]</xpath>
    <value>
      <fuelIconPath>Things/Item/Resource/Aq_NoIceBlocks</fuelIconPath>
    </value>
  </Operation>
</Patch>
