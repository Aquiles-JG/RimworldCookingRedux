<?xml version="1.0" encoding="utf-8" ?>

<Defs>
<RecipeDef>
    <defName>Aq_CookFishSteak</defName>
    <label>cook grilled fish steak</label>
    <description>Cook four fish steaks.</description>
    <jobString>Cooking fish steak.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <fixedIngredientFilter>
			<categories>
				<li>RF_RawSeafood</li>
			</categories>
			<disallowedThingDefs>
				<li>Caviar</li>
				<li>SalmonRoe</li>
				<li>JellyfishMeat</li>
				<li>RawShellfishMeat</li>
			</disallowedThingDefs>
	</fixedIngredientFilter>
	<defaultIngredientFilter>
			<categories>
				<li>RF_RawSeafood</li>
			</categories>
			<disallowedThingDefs>
				<li>SeaCucumberMeat</li>
				<li>RawCrabMeat</li>
			</disallowedThingDefs>		
   </defaultIngredientFilter>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>RF_RawSeafood</li>
          </categories>
        </filter>
        <count>2.0</count>
      </li>
    </ingredients>
    <products>
      <Aq_FishSteak>4</Aq_FishSteak>
    </products>
    <workSkill>Cooking</workSkill>
    <recipeUsers>
        <li>Campfire</li>
        <li>ElectricStove</li>
        <li>FueledStove</li>
        <li>Aq_Grill</li>
    </recipeUsers>
</RecipeDef>

<RecipeDef>
	<defName>Aq_CookSeafoodStew</defName>
	<label>cook seafood rice</label>
	<description>Cook two bowls of steamy rice stew made with fish or seafood. Simmering it over a long period of time results in the richest, most perfect gravy to warm your bones after a day out in the cold.</description>
	<jobString>Cooking seafood stew.</jobString>
	<workAmount>3200</workAmount>
	<allowMixingIngredients>true</allowMixingIngredients>
	<ingredientValueGetterClass>CookingRedux.IngredientValueGetter_NutritionWithExtraIngredient</ingredientValueGetterClass>
	 <recipeUsers>
        <li>FueledStove</li>
        <li>ElectricStove</li>
      </recipeUsers>
	<fixedIngredientFilter>
			<categories>
				<li>RF_RawSeafood</li>
			</categories>
			<disallowedThingDefs>
				<li>Caviar</li>
				<li>SalmonRoe</li>
			</disallowedThingDefs>
			<thingDefs>
				<li>RawRice</li>
				<li>Aq_RawSaffron</li>
			</thingDefs>
	</fixedIngredientFilter>
	<defaultIngredientFilter>
			<categories>
				<li>RF_RawSeafood</li>
			</categories>
			<thingDefs>
				<li>RawRice</li>
				<li>Aq_RawSaffron</li>
			</thingDefs>
   </defaultIngredientFilter>
   <ingredients>
			<li>
				<filter>
					<categories>
						<li>RF_RawSeafood</li>
					</categories>
				</filter>
				<count>2.0</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>RawRice</li>
					</thingDefs>
				</filter>
				<count>2.0</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Aq_RawSaffron</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>		
  </ingredients>
	<products>
	  <Aq_SeafoodStew>2</Aq_SeafoodStew>
	</products>
	<workSpeedStat>CookSpeed</workSpeedStat>
      <workSkill>Cooking</workSkill>
      <effectWorking>Cook</effectWorking>
   	 <soundWorking>Recipe_CookMeal</soundWorking>
        <skillRequirements>
     	<Cooking>8</Cooking>
    	</skillRequirements>
      <researchPrerequisites>
			<li>Aq_CookingIII</li>
		</researchPrerequisites>      
</RecipeDef>

<RecipeDef>
