<?xml version="1.0" encoding="utf-8"?>
<Patch>



<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Plants Expanded</li>
		</mods>
	  
		<match Class="PatchOperationSequence">
			<operations>

				<!-- No Beets-->
				<li Class="PatchOperationRemove"> 
					<xpath>/Defs/ThingDef[defName = "VCE_RawBeets" or defName="VCE_Beet"]</xpath>
					
				</li>
				
				<!-- No immortal tomatoes-->
				<li Class="PatchOperationRemove"> 
					<xpath>/Defs/ThingDef[defName="VCE_Tomato"]/plant/harvestAfterGrowth</xpath>
					
				</li>
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/ThingDef[defName="VCE_Tomato"]/description</xpath>
					<value>
						<description>A series of juicy, glossy red fruits attached by vine, used commonly as a vegetable. Strong stewing releases natural sugars and mellows out acids contained within.</description>		
					</value>
				</li>
				
				<!-- No Fruit Category-->
				<li Class="PatchOperationReplace">
          			<xpath>/Defs/ThingDef[defName="VCE_RawApple" or defName="VCE_RawPeach" or defName="VCE_RawCherry" or defName="VCE_RawPlum" or defName="VCE_RawPrunes" or defName="VCE_RawPear" or defName="VCE_RawPricklyPear" or defName="VCE_Bearberry" or defName="VCE_RawBanana" or defName="VCE_RawOrange"]/thingCategories</xpath>
          			<value>
						<thingCategories>
							<li>Aq_Fruit</li>
						</thingCategories>
          			</value>
        		</li>
				<li Class="PatchOperationRemove"> 
					<xpath>/Defs/ThingCategoryDef[defName = "VCE_Fruit"]</xpath>
					
				</li>
				
				<!-- Cabbages renamed to Lettuces -->
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/ThingDef[defName="VCE_Cabbage"]/label</xpath>
					<value>
						<label>lettuce plant</label>		
					</value>
				</li>
				
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/ThingDef[defName="VCE_Cabbage"]/description</xpath>
					<value>
						<description>A cultivated plant of the daisy family, with edible leaves that are eaten in salads.</description>		
					</value>
				</li>

				
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/ThingDef[defName="VCE_RawCabbage"]/label</xpath>
					<value>
						<label>lettuces</label>		
					</value>
				</li>
				
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/ThingDef[defName="VCE_RawCabbage"]/description</xpath>
					<value>
						<description>A plant with large, green leaves, eaten uncooked in salads.</description>		
					</value>
				</li>
				
				<li Class="PatchOperationAdd"> 
					<xpath>/Defs/RecipeDef[defName = "Aq_CookLentilSoup" or defName="Aq_MakeTrufflePasta" or defName="Aq_CookVegetableSoup"]/ingredients/li[2]/filter/thingDefs</xpath>
					<value>
						<li>VCE_RawOnion</li>
					</value>
				</li>
				<li Class="PatchOperationAdd"> 
					<xpath>/Defs/RecipeDef[defName = "Aq_CookLentilSoup" or defName="Aq_MakeTrufflePasta" or defName="Aq_CookVegetableSoup"]/fixedIngredientFilter/thingDefs</xpath>
					<value>
						<li>VCE_RawOnion</li>
					</value>
				</li>
				<li Class="PatchOperationAdd"> 
					<xpath>/Defs/RecipeDef[defName = "Aq_CookLentilSoup" or defName="Aq_MakeTrufflePasta" or defName="Aq_CookVegetableSoup"]/defaultIngredientFilter/thingDefs</xpath>
					<value>
						<li>VCE_RawOnion</li>
					</value>
				</li>
				
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/RecipeDef[defName = "Aq_BakeMeatloaf"]/fixedIngredientFilter/thingDefs/li[text()="Aq_RawGarlic"]</xpath>
					<value>
						<li>VCE_RawOnion</li>
					</value>
				</li>
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/RecipeDef[defName = "Aq_BakeMeatloaf"]/defaultIngredientFilter/thingDefs/li[text()="Aq_RawGarlic"]</xpath>
					<value>
						<li>VCE_RawOnion</li>
					</value>
				</li>
				<li Class="PatchOperationReplace"> 
					<xpath>/Defs/RecipeDef[defName = "Aq_BakeMeatloaf"]/ingredients/li[2]/filter/thingDefs/li[text()="Aq_RawGarlic"]</xpath>
					<value>
						<li>VCE_RawOnion</li>
					</value>
				</li>
				
				<li Class="PatchOperationAdd"> 
					<xpath>/Defs/RecipeDef[defName="Aq_CookVegetableSoup"]/ingredients/li[1]/filter/thingDefs</xpath>
					<value>
						<li>VCE_RawPeas</li>
					</value>
				</li>
				<li Class="PatchOperationAdd"> 
					<xpath>/Defs/RecipeDef[defName="Aq_CookVegetableSoup"]/fixedIngredientFilter/thingDefs</xpath>
					<value>
						<li>VCE_RawPeas</li>
					</value>
				</li>
				<li Class="PatchOperationAdd"> 
					<xpath>/Defs/RecipeDef[defName="Aq_CookVegetableSoup"]/defaultIngredientFilter/thingDefs</xpath>
					<value>
						<li>VCE_RawPeas</li>
					</value>
				</li>
				
			</operations>
		</match>
		
	</Operation>
	

</Patch>