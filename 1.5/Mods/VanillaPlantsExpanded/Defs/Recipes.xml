<?xml version="1.0" encoding="utf-8"?>
<Defs>

<!-- Recipes-->
 <RecipeDef>
	<defName>Aq_BakeChocolateCake</defName>
	<label>bake chocolate cherry cake</label>
	<description>Bake two slices of wonderful chocolate cherry cake.</description>
	<jobString>Baking cake.</jobString>
    <workAmount>3200</workAmount>
	<allowMixingIngredients>true</allowMixingIngredients>
	<ingredientValueGetterClass>CookingRedux.IngredientValueGetter_NutritionWithExtraIngredient</ingredientValueGetterClass>
	<ingredients>
     <li>
		<filter>
			 <thingDefs>
				<li>Chocolate</li>
			 </thingDefs>
		</filter>
	    <count>0.9</count>
     </li>
     <li>
		<filter>
			 <thingDefs>
				<li>VCE_RawCherry</li>
			 </thingDefs>
		</filter>
	    <count>2.1</count>
     </li>
      <li>
	    <filter>
	      <thingDefs>
	        <li>Aq_Sugar</li>
	      </thingDefs>
	    </filter>
	    <count>2</count>
	  </li>
	</ingredients>
	<fixedIngredientFilter>
	  <thingDefs>
	    <li>Aq_Sugar</li>
	    <li>VCE_RawCherry</li>
	    <li>Chocolate</li>
	  </thingDefs>
      <specialFiltersToDisallow>
        <li>AllowRotten</li>
      </specialFiltersToDisallow>
	</fixedIngredientFilter>
	<products>
	  <Aq_ChocolateCake>2</Aq_ChocolateCake>
	</products>
	<workSpeedStat>CookSpeed</workSpeedStat>
      <workSkill>Cooking</workSkill>
      <effectWorking>Cook</effectWorking>
   	 <soundWorking>Recipe_CookMeal</soundWorking>
        <skillRequirements>
     		<Cooking>8</Cooking>
    	</skillRequirements>
      <recipeUsers>
        <li>Aq_Oven</li>
        <li>Aq_ElectricOven</li>
      </recipeUsers>
       <researchPrerequisites>
		<li>Aq_BakeryII</li>
	</researchPrerequisites>
</RecipeDef>

<RecipeDef>
    <defName>Aq_MakeSalad</defName>
    <label>make green salad</label>
    <description>Make four salads consisting chiefly of lettuce and other fresh green vegetables.</description>
    <jobString>Making salad.</jobString>
    <workAmount>1200</workAmount> 
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
   <fixedIngredientFilter>
			<thingDefs>
				<li>VCE_RawCabbage</li>
				<li>VCE_RawOnion</li>
				<li>VCE_RawTomatoes</li>
				<li>Aq_BoiledEgg</li>
			</thingDefs>
   </fixedIngredientFilter>
   <defaultIngredientFilter>
			<thingDefs>
				<li>VCE_RawCabbage</li>
				<li>VCE_RawOnion</li>
				<li>VCE_RawTomatoes</li>
				<li>Aq_BoiledEgg</li>
			</thingDefs>
   </defaultIngredientFilter>
   <ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>VCE_RawCabbage</li>
					</thingDefs>
				</filter>
				<count>1.4</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>VCE_RawOnion</li>
						<li>VCE_RawTomatoes</li>
						<li>Aq_BoiledEgg</li>
					</thingDefs>
				</filter>
				<count>0.6</count>
			</li>
  </ingredients>
	<products>
	  <Aq_Salad>4</Aq_Salad>
	</products>
	<workSpeedStat>CookSpeed</workSpeedStat>
      <workSkill>Cooking</workSkill>
       <requiredGiverWorkType>Cooking</requiredGiverWorkType>
      <effectWorking>Cook</effectWorking>
   	 <soundWorking>Recipe_CookMeal</soundWorking>
	<recipeUsers>
        <li>ElectricStove</li>
	    <li>FueledStove</li>
     </recipeUsers>
     <skillRequirements>
		<Cooking>4</Cooking>
	</skillRequirements>
     <researchPrerequisites>
			<li>Aq_Cooking</li>
		</researchPrerequisites>
</RecipeDef>

<RecipeDef>
	<defName>Aq_GrillKebab</defName>
	<label>grill kebab</label>
	<description>Grill three juicy kebabs.</description>
	<jobString>Grilling kebabs.</jobString>
    <workAmount>1800</workAmount>
	<allowMixingIngredients>true</allowMixingIngredients>
	<ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
	<fixedIngredientFilter>
			<categories>
				<li>MeatRaw</li>
			</categories>
			<thingDefs>
				<li>VCE_RawPepper</li>
			</thingDefs>
	</fixedIngredientFilter>
	<defaultIngredientFilter>
			<categories>
				<li>MeatRaw</li>
			</categories>
			<disallowedThingDefs>
				<li>Meat_Human</li>
				<li>Meat_Megaspider</li>
				<li>Sausage_Raw</li>
				<li MayRequire="Ludeon.Rimworld.Anomaly">Meat_Twisted</li>
			</disallowedThingDefs>
			<thingDefs>
				<li>VCE_RawPepper</li>
			</thingDefs>
   </defaultIngredientFilter>
   <ingredients>
			<li>
				<filter>
					<categories>
						<li>MeatRaw</li>
					</categories>
				</filter>
				<count>2.0</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>VCE_RawPepper</li>
					</thingDefs>
				</filter>
				<count>1.0</count>
			</li>	
  </ingredients>
	<products>
	  <Aq_Kebab>3</Aq_Kebab>
	</products>
	<workSpeedStat>CookSpeed</workSpeedStat>
      <workSkill>Cooking</workSkill>
       <requiredGiverWorkType>Cooking</requiredGiverWorkType>
      <effectWorking>Cook</effectWorking>
   	 <soundWorking>Recipe_CookMeal</soundWorking>
      <recipeUsers>
        <li>Aq_Grill</li>
      </recipeUsers>
      <skillRequirements>
		<Cooking>6</Cooking>
	</skillRequirements>
      <researchPrerequisites>
			<li>Aq_CookingII</li>
		</researchPrerequisites>   
</RecipeDef>
				
