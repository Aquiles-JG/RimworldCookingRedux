<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="MealCooked">
		<defName>Aq_Meatloaf</defName>
		<label>meatloaf</label>
		<description>Meatloaf is a baked dish consisting of ground meat combined with vegetable and spices moulded into the shape of a loaf. It boosts breathing and consciousness for a little period of time. It helps you to learn faster too.</description>
		<graphicData>	
			<texPath>Things/Items/Meatloaf</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>21.85</MarketValue>
			<Nutrition>0.9</Nutrition>
		</statBases>
		<ingestible>
			<preferability>MealFine</preferability>
     		<tasteThought>Aq_AteMeatloaf</tasteThought>
      		<ingestEffect>EatVegetarian</ingestEffect>
      		<ingestSound>Meal_Eat</ingestSound>
      		<maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      	 		<outcomeDoers>
					<li Class="IngestionOutcomeDoer_GiveHediff">
		 			<hediffDef>Aq_AteMeatloaf</hediffDef>
		 			<severity>0.25</severity>
					</li>
				</outcomeDoers>
		</ingestible>
		<tradeTags>
      		<li>Aq_Foods</li>
    	</tradeTags>	
	</ThingDef>
		

</Defs>