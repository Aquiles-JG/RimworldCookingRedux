<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--Base-->
  <ThingDef Name="Aq_PreserveBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Mass>0.06</Mass>
    </statBases>
    <thingCategories>
      <li>Aq_Preserves</li>
    </thingCategories>
    <stackLimit>75</stackLimit>
    <altitudeLayer>Item</altitudeLayer>
    <tickerType>Rare</tickerType>
    <socialPropernessMatters>true</socialPropernessMatters>
    <alwaysHaulable>true</alwaysHaulable>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_FoodPoisonable" />
    </comps>
    <pathCost>15</pathCost>
    <resourceReadoutPriority>Last</resourceReadoutPriority>
    <drawGUIOverlay>true</drawGUIOverlay>
    <ingestible>
      <foodType>Meal</foodType>
      <ingestSound>Meal_Eat</ingestSound>
      <optimalityOffsetHumanlikes>12</optimalityOffsetHumanlikes>
      <chairSearchRadius>60</chairSearchRadius>
    </ingestible>
    <tradeTags>
	   <li>Aq_BasicFoods</li>
	</tradeTags>
  </ThingDef>
  
  <!-- Salted Meat -->
  <ThingDef ParentName="Aq_PreserveBase">
	<defName>Aq_SaltedMeat</defName>
	<label>salted meat</label>
	<description>Meat preserved with salt. Salt absorbs water and kills bacteria, preventing them to rot the meat. It can last a whole year without a freezer.</description>
	<graphicData>	
		<texPath>Things/Items/Preserves/SaltedMeat</texPath>
		<graphicClass>Graphic_StackCount</graphicClass>
		<drawSize>0.85</drawSize>
	</graphicData>
	<stackLimit>25</stackLimit>
	<statBases>
		<MarketValue>6</MarketValue>  <!-- Price nerfed for balance-->
		<Mass>0.18</Mass>
		<Nutrition>0.3</Nutrition>
	</statBases>
	<ingestible>
		<preferability>RawTasty</preferability>
		<ingestEffect>EatMeat</ingestEffect>
		<ingestSound>RawMeat_Eat</ingestSound>
		<maxNumToIngestAtOnce>3</maxNumToIngestAtOnce>
	</ingestible>
	<comps>
	 	<li Class="CompProperties_Ingredients">
			<noIngredientsFoodKind>Meat</noIngredientsFoodKind>
	  	</li>
		<li Class="CompProperties_Rottable">
			<daysToRotStart>60</daysToRotStart>
			<rotDestroys>true</rotDestroys>
		</li>
	</comps>
	<researchPrerequisites>
		<li>Aq_Salting</li>
	</researchPrerequisites>
  </ThingDef>
    
  <!-- Table Olives-->
  <ThingDef ParentName="Aq_PreserveBase">
    <defName>Aq_Olives</defName>
    <label>table olives</label>
    <description>Canned olives that have undergone curing and brining.</description>
    <graphicData>
      <texPath>Things/Items/Preserves/Olives</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>1.65</MarketValue>  <!-- +20% overpriced for balance-->
      <Nutrition>0.05</Nutrition>
    </statBases>
    <ingestible>
      <joy>0.05</joy>
      <joyKind>Gluttonous</joyKind>
      <tasteThought>Aq_HadTableOlives</tasteThought>
      <foodType>VegetableOrFruit</foodType>
      <preferability>RawTasty</preferability>
      <ingestEffect>EatVegetarian</ingestEffect>
      <maxNumToIngestAtOnce>9</maxNumToIngestAtOnce>
    </ingestible>
    <comps>
      <li Class="CompProperties_Ingredients">
		<noIngredientsFoodKind>NonMeat</noIngredientsFoodKind>
	  </li>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>90</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>
</Defs>
