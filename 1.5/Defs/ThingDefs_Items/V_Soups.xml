<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Lentil Soup -->
	<ThingDef ParentName="MealCooked">	
		<defName>Aq_LentilSoup</defName>
		<label>lentil soup</label>
		<description>A thick soup with lentils as its main ingredient. It improves consciousness and global work speed for a short period of time.</description>
		<graphicData>	
			<texPath>Things/Items/Soups/LentilSoup</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>14.65</MarketValue>
			<Nutrition>0.9</Nutrition>
		</statBases>
		<ingestible>
			<preferability>MealFine</preferability>
			<tasteThought>Aq_AteLentilSoup</tasteThought>
      	 <outcomeDoers>
			<li Class="IngestionOutcomeDoer_GiveHediff">
		 	<hediffDef>Aq_AteLentilSoup</hediffDef>
		 	<severity>0.25</severity>
			</li>
		</outcomeDoers>
		</ingestible>
		 <tradeTags>
      		<li>Aq_Foods</li>
    	</tradeTags>
    	<tradeability>Sellable</tradeability>
	</ThingDef>
	
	<!-- Vegetable Soup -->
	<ThingDef ParentName="MealCooked">
		<defName>Aq_VegetableSoup</defName>
		<label>vegetable soup</label>
		<description>A common soup prepared using vegetables and leaf vegetables as primary ingredients. It helps with hunger for a short period of time.</description>
		<graphicData>	
			<texPath>Things/Items/Soups/VegetableSoup</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>11</MarketValue>
			<Nutrition>0.9</Nutrition>
		</statBases>
		<ingestible>
			<preferability>MealSimple</preferability>
			<tasteThought>Aq_AteVegetableSoup</tasteThought>
      	 <outcomeDoers>
			<li Class="IngestionOutcomeDoer_GiveHediff">
		 	<hediffDef>Aq_AteVegetableSoup</hediffDef>
		 	<severity>0.25</severity>
			</li>
		</outcomeDoers>
		</ingestible>
		 <tradeTags>
      		<li>Aq_Foods</li>
    	</tradeTags>
    	<tradeability>Sellable</tradeability>
	</ThingDef>

</Defs>