    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Nutrition>0.7</Nutrition>
      <Mass>0.25</Mass>
    </statBases>
    <ingestible>
      <ingestEffect>EatVegetarian</ingestEffect>
