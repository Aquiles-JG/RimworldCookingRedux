      <li>Aq_Foods</li>
    </tradeTags>
  </ThingDef>
  
  <ThingDef ParentName="Aq_MealDessertBase">
    <defName>Aq_Icecream</defName>
    <label>ice cream</label>
    <description>A food produced by freezing, while stirring, a pasteurized mix consisting of one or more of the optional dairy ingredients. It helps with pain and surviving social life for a little period of time.</description>
    <graphicData>
      <texPath>Things/Items/Desserts/Icecream</texPath>
    </graphicData>
    <statBases>
      <MarketValue>22.3</MarketValue>
    </statBases>
    <ingestible>
      <preferability>MealLavish</preferability>
      <joy>0.8</joy>
      <tasteThought>Aq_AteIcecream</tasteThought>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>Aq_AteIcecream</hediffDef>
          <severity>0.25</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <thingCategories>
		<li>FoodMeals</li>
	</thingCategories>
  </ThingDef>
  
