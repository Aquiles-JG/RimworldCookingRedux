<?xml version="1.0" encoding="utf-8"?>
<Defs>

<ThingDef ParentName="ResourceBase">
		<defName>Aq_SodaSyrup</defName>
		<label>cola syrup</label>
		<description>A thick and disgustingly sweet mixture made by boiling citric acid and natural sugars together - Usually derived straight from cane sugar. Must be cut with water and left to carbonate briefly in a sealed environment before consumption.</description>
		<graphicData>
			<texPath>Things/Items/Musts/Aq_SodaSyrup</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<healthAffectsPrice>false</healthAffectsPrice>
		<rotatable>false</rotatable>
		<stackLimit>25</stackLimit>
		<thingCategories>
			<li>Aq_Musts</li>
		</thingCategories>
		<tradeability>None</tradeability>
		<statBases>
			<DeteriorationRate>1.0</DeteriorationRate>
			<MarketValue>2.5</MarketValue>
			<Mass>0.8</Mass>
			<Flammability>0.2</Flammability>
			<MaxHitPoints>60</MaxHitPoints>
		</statBases>
		<tickerType>Rare</tickerType>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>5</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
			<li Class="CompProperties_Ingredients"/>
		</comps>
		<ingestible>
			<foodType>VegetableOrFruit</foodType>
			<preferability>NeverForNutrition</preferability>
		</ingestible>
	</ThingDef>
	
