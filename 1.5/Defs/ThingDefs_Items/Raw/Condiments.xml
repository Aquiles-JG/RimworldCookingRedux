<Defs>
  
  
  <ThingDef ParentName="RoughPlantBase">
		<defName>Aq_RawCinnamon</defName>
		<label>cinnamon canes</label>
		<description>A spice obtained from the inner bark of several tree species from the genus Cinnamomum. Cinnamon is used mainly as an aromatic condiment and flavouring additive in a wide variety of cuisines.</description>
		<graphicData>
			<texPath>Things/Items/Condiments/Aq_Cinnamon</texPath>
		</graphicData>
		<statBases>
			<MarketValue>6.6</MarketValue>
			<Nutrition>0</Nutrition>
			<Flammability>1.3</Flammability>
		</statBases>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>60</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
		<thingCategories>
			<li>Aq_Condiments</li>
		</thingCategories>
		<ingestible>
			<preferability>NeverForNutrition</preferability>
			<optimalityOffsetFeedingAnimals>-50</optimalityOffsetFeedingAnimals>
		</ingestible>
		<ingredient>
		  <mergeCompatibilityTags>
			<li>Condiments</li>
		  </mergeCompatibilityTags>
		</ingredient>
	</ThingDef>
	
