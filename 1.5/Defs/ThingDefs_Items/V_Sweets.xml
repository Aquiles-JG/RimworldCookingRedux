<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Important: sweets need to be patched individually in Common/Patches/FoodFilters.xml-->
  <ThingDef Name="Aq_MealSweetBase" ParentName="MealCooked" Abstract="True">
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Nutrition>0.3</Nutrition>
      <Mass>0.25</Mass>
    </statBases>
    <ingestible>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <joyKind>Aq_Sweets</joyKind>
      <maxNumToIngestAtOnce>3</maxNumToIngestAtOnce>
    </ingestible>
    <thingCategories>
		<li>FoodMeals</li>
	</thingCategories>
    <tradeTags>
      <li>Aq_Foods</li>
    </tradeTags>
  </ThingDef>
  
  <ThingDef ParentName="Aq_MealSweetBase">
    <defName>Aq_Candy</defName>
    <label>candy</label>
    <description>A small piece of sweet food made from sugar with chocolate, fruit, nuts, or flavors added. It helps with social impact and mental break threshold for a short period of time.</description>
    <graphicData>
      <texPath>Things/Items/Sweets/Candy</texPath>
    </graphicData>
    <statBases>
      <MarketValue>9.4</MarketValue>
      <Mass>0.05</Mass>
    </statBases>
    <ingestible>
      <preferability>MealSimple</preferability>
      <joy>0.6</joy>
      <tasteThought>Aq_AteCandy</tasteThought>
       <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>Aq_AteCandy</hediffDef>
          <severity>0.25</severity>
        </li>
      </outcomeDoers>
    </ingestible>
  </ThingDef>
  
  <ThingDef ParentName="Aq_MealSweetBase">
    <defName>Aq_Cookies</defName>
    <label>cookies</label>
    <description>A sweet biscuit having a fairly soft, chewy texture and typically containing pieces of chocolate or fruit. It helps with global learning for a short period of time.</description>
    <graphicData>
      <texPath>Things/Items/Desserts/Cookies</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>10.8</MarketValue>
    </statBases>
    <ingestible>
      <preferability>MealSimple</preferability>
      <joy>0.6</joy>
      <tasteThought>Aq_AteCookies</tasteThought>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>Aq_AteCookies</hediffDef>
          <severity>0.25</severity>
        </li>
      </outcomeDoers>
    </ingestible>
  </ThingDef>
  
   <ThingDef ParentName="Aq_MealSweetBase">
    <defName>Aq_MintCreamCookie</defName>
    <label>mint cream cookies</label>
    <description>A chocolate cookie with mint cream filling. It reduces pain and boosts social impact for a short period of time.</description>
    <graphicData>
      <texPath>Things/Items/Sweets/MintCreamCookie</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>20.65</MarketValue>
    </statBases>
    <ingestible>
      <preferability>MealFine</preferability>
      <joy>0.7</joy>
      <tasteThought>Aq_AteMintCookie</tasteThought>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>Aq_AteMintCookie</hediffDef>
          <severity>0.25</severity>
        </li>
      </outcomeDoers>
    </ingestible>
  </ThingDef>
  
</Defs>