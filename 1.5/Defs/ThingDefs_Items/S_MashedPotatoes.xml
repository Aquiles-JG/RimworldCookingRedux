<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Mashed Potatoes -->
	<ThingDef ParentName="MealCooked">
		
		<!-- Basic Properties -->
		<defName>Aq_MashedPotatoes</defName>
		<label>mashed potatoes</label>
		<description>A dish made by mashing boiled potatoes, usually with added milk, butter, salt and pepper. It improves breathing for a short period of time.</description>
		
		
		<!-- Graphic -->
		<graphicData>	
			<texPath>Things/Items/MashedPotatoes</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		
		<!-- Properties -->
		<statBases>
			<MarketValue>13.4</MarketValue>
			<Nutrition>0.9</Nutrition>	
		</statBases>
		
		<ingestible>
			
			<preferability>MealSimple</preferability>
			<tasteThought>Aq_AteMashed</tasteThought>
      		<ingestEffect>EatVegetarian</ingestEffect>
      		<ingestSound>Meal_Eat</ingestSound>
      		<maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      	 	<outcomeDoers>
				<li Class="IngestionOutcomeDoer_GiveHediff">
		 		<hediffDef>Aq_AteMashed</hediffDef>
		 		<severity>0.25</severity>
			</li>
			</outcomeDoers>
		</ingestible>
		<tradeTags>
      		<li>Aq_Foods</li>
    	</tradeTags>
    	
	</ThingDef>
	
	

</Defs>