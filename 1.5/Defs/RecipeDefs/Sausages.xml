<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <RecipeDef>
    <defName>Aq_GrillSausages</defName>
    <label>grill sausages</label>
    <description>Grill four sausages.</description>
    <jobString>Grilling sausages.</jobString>
    <workAmount>1200</workAmount>
    <workSkill>Cooking</workSkill>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Sausage_Raw</li>
          </thingDefs>
        </filter>
        <count>1.2</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>0.8</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Sausage_Raw</li>
      </thingDefs>
      <categories>
        <li>PlantFoodRaw</li>
      </categories>
      <disallowedCategories>
		<li>Aq_Fruit</li>
	  </disallowedCategories>	
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <thingDefs>
        <li>Sausage_Raw</li>
      </thingDefs>
      <categories>
        <li>PlantFoodRaw</li>
      </categories>
    </defaultIngredientFilter>
    <products>
      <Aq_Sausages>4</Aq_Sausages>
    </products> 
    <recipeUsers>
      <li>Campfire</li>
      <li>Aq_Grill</li>
    </recipeUsers>
    <skillRequirements>
      <Cooking>4</Cooking>
    </skillRequirements>
    <researchPrerequisites>
      <li>Aq_Processing</li>
    </researchPrerequisites>
  </RecipeDef>
  
</Defs>
