    <jobString>Making pancakes.</jobString>
    <workAmount>1200</workAmount> 
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
   
   <fixedIngredientFilter>
      	<thingDefs>
			<li>Aq_Flour</li>
			<li>Milk</li>
			<li>Aq_VegMilk</li>
			<li>Aq_Butter</li>
		</thingDefs>	
   </fixedIngredientFilter>
   <defaultIngredientFilter>
			<thingDefs>
				<li>Aq_Flour</li>
				<li>Milk</li>
				<li>Aq_VegMilk</li>
				<li>Aq_Butter</li>
			</thingDefs>
   </defaultIngredientFilter>
   <ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Aq_Flour</li>
					</thingDefs>
				</filter>
				<count>0.9</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Milk</li>
						<li>Aq_VegMilk</li>
						<li>Aq_Butter</li>
					</thingDefs>
				</filter>
				<count>0.3</count>
			</li>	
