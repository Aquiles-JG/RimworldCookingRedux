  <RecipeDef>
    <defName>Aq_MakeTiramisu</defName>
    <label>make tiramisu</label>
    <description>Make three pieces of tiramisu.</description>
    <jobString>Making tiramisu.</jobString>
    <workAmount>1800</workAmount>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>CookingRedux.IngredientValueGetter_NutritionWithExtraIngredient</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_RawCoffee</li>
          </thingDefs>
        </filter>
        <count>1.4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_Cream</li>
            <li>Aq_Butter</li>
            <li>Aq_Cheese</li>
          </thingDefs>
        </filter>
        <count>0.6</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_Sugar</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
    </ingredients>
    <defaultIngredientFilter>
      <thingDefs>
        <li>Aq_Sugar</li>
        <li>Aq_RawCoffee</li>
        <li>Aq_Cream</li>
        <li>Aq_Butter</li>
      </thingDefs>
      <disallowedThingDefs>
        <li>Aq_Cheese</li>
      </disallowedThingDefs>
    </defaultIngredientFilter>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Aq_Sugar</li>
        <li>Aq_RawCoffee</li>
        <li>Aq_Cream</li>
        <li>Aq_Butter</li>
        <li>Aq_Cheese</li>
      </thingDefs>
      <specialFiltersToDisallow>
        <li>AllowRotten</li>
      </specialFiltersToDisallow>
    </fixedIngredientFilter>
    <products>
      <Aq_Tiramisu>3</Aq_Tiramisu>
    </products>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <skillRequirements>
      <Cooking>6</Cooking>
    </skillRequirements>
    <recipeUsers>
      <li>Aq_CandyCooker</li>
    </recipeUsers>
    <researchPrerequisites>
      <li>Aq_BakeryIII</li>
      <li>Aq_Brewing</li>
    </researchPrerequisites>
  </RecipeDef>
  
</Defs>
