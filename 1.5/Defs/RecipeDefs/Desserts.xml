<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <RecipeDef>
    <defName>Aq_MakeIcecream</defName>
    <label>make ice cream</label>
    <description>Make two ice creams.</description>
    <jobString>Making ice cream.</jobString>
    <workAmount>3200</workAmount>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>CookingRedux.IngredientValueGetter_NutritionWithExtraIngredient</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Milk</li>
            <li>Aq_VegMilk</li>
            <li>Aq_Cream</li>
          </thingDefs>
        </filter>
        <count>2.0</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>Aq_Fruit</li>
          </categories>
        </filter>
        <count>1.0</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_Sugar</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Aq_Fruit</li>
      </categories>
      <thingDefs>
        <li>Milk</li>
        <li>Aq_VegMilk</li>
        <li>Aq_Cream</li>
        <li>Aq_Sugar</li>
      </thingDefs>
      <specialFiltersToDisallow>
        <li>AllowRotten</li>
      </specialFiltersToDisallow>
    </fixedIngredientFilter>
    <products>
      <Aq_Icecream>2</Aq_Icecream>
    </products>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <skillRequirements>
      <Cooking>8</Cooking>
    </skillRequirements>
    <recipeUsers>
      <li>Aq_CandyCooker</li>
    </recipeUsers>
    <researchPrerequisites>
      <li>Aq_BakeryIII</li>
    </researchPrerequisites>
  </RecipeDef>
  
  <RecipeDef>
