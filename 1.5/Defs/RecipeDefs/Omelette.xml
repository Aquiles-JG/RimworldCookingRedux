<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>Aq_MakeOmelette</defName>
    <label>make omelette</label>
    <description>Make four egg omelettes.</description>
    <jobString>Making omelettes.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>CookingRedux.IngredientValueGetter_NutritionWithExtraIngredient</ingredientValueGetterClass>
    <fixedIngredientFilter>
      <categories>
		 <li>EggsUnfertilized</li>
	  </categories>
      <thingDefs>
        <li>Aq_OliveOil</li>
      </thingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
		 <li>EggsUnfertilized</li>
	  </categories>
      <thingDefs>
        <li>Aq_OliveOil</li>
      </thingDefs>
    </defaultIngredientFilter>
    <ingredients>
      <li>
        <filter>
          <categories>
			 <li>EggsUnfertilized</li>
		  </categories>
        </filter>
        <count>2.0</count> 
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_OliveOil</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <products>
      <Aq_Omelette>4</Aq_Omelette>
    </products>
    <recipeUsers>
      <li>ElectricStove</li>
      <li>FueledStove</li>
    </recipeUsers>
    <skillRequirements>
      <Cooking>4</Cooking>
    </skillRequirements>
    <researchPrerequisites>
      <li>Aq_Cooking</li>
    </researchPrerequisites>
  </RecipeDef>
</Defs>
