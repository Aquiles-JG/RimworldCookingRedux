<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <RecipeDef>
	<defName>Aq_CookBowlstew</defName>
	<label>cook beef stew</label>
	<description>Cook two classic stews mainly with beef and potatoes.</description>
	<jobString>Cooking beefstew.</jobString>
	<workAmount>3200</workAmount>
	<allowMixingIngredients>true</allowMixingIngredients>
	<ingredientValueGetterClass>CookingRedux.IngredientValueGetter_NutritionWithExtraIngredient</ingredientValueGetterClass>
	
	 <recipeUsers>
        <li>FueledStove</li>
        <li>ElectricStove</li>
      </recipeUsers>
	<fixedIngredientFilter>
			<categories>
				<li>MeatRaw</li>
			</categories>
			<thingDefs>
				<li>RawPotatoes</li>
				<li>Aq_RawSaffron</li>
				<li>Aq_OliveOil</li>
			</thingDefs>
	</fixedIngredientFilter>
	
	<defaultIngredientFilter>
			<categories>
				<li>MeatRaw</li>
			</categories>
			<thingDefs>
				<li>RawPotatoes</li>
				<li>Aq_OliveOil</li>
			</thingDefs>
			<disallowedThingDefs>
				<li>Meat_Human</li>
				<li>Meat_Megaspider</li>
				<li MayRequire="Ludeon.Rimworld.Anomaly">Meat_Twisted</li>
				<li>Sausage_Raw</li>
				<li>Aq_RawSaffron</li>
			</disallowedThingDefs>		
   </defaultIngredientFilter>
   
   <ingredients>
			<li>
				<filter>
					<categories>
						<li>MeatRaw</li>
					</categories>
				</filter>
				<count>2.0</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>RawPotatoes</li>
					</thingDefs>
				</filter>
				<count>2.0</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Aq_RawSaffron</li>
						<li>Aq_OliveOil</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>		
  </ingredients>
	
	<products>
	  <Aq_Bowlstew>2</Aq_Bowlstew>
	</products>
	<workSpeedStat>CookSpeed</workSpeedStat>
      <workSkill>Cooking</workSkill>
      <effectWorking>Cook</effectWorking>
   	 <soundWorking>Recipe_CookMeal</soundWorking>
        <skillRequirements>
     		<Cooking>8</Cooking>
    	</skillRequirements>
     
      <researchPrerequisites>
			<li>Aq_CookingIII</li>
		</researchPrerequisites>
      
</RecipeDef>


</Defs>