<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Ice Blocks Base -->
  <RecipeDef Name="Aq_MakeIceBase" Abstract="True">
    <description>Make ice blocks from hay using endo-thermic principals.</description>
    <jobString>Making ice blocks.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <workAmount>800</workAmount>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <recipeUsers>
      <li>CraftingSpot</li>
      <li>Aq_CandyCooker</li>
    </recipeUsers>
    <researchPrerequisites>
      <li>Aq_IceMaking</li>
    </researchPrerequisites>
  </RecipeDef>
  
  <RecipeDef ParentName="Aq_MakeIceBase">
    <defName>Aq_MakeIceBlocks</defName>
    <label>make ice blocks</label>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Hay</li>
          </thingDefs>
        </filter>
        <count>2.0</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Hay</li>
      </thingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <thingDefs>
        <li>Hay</li>
      </thingDefs>
    </defaultIngredientFilter>
    <products>
      <Aq_IceBlocks>20</Aq_IceBlocks>
    </products>  
  </RecipeDef>
  
  <RecipeDef ParentName="Aq_MakeIceBase">
    <defName>Aq_MakeIceBlocksBulk</defName>
    <label>make ice blocks in bulk</label>
    <workAmount>1200</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Hay</li>
          </thingDefs>
        </filter>
        <count>4.0</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Hay</li>
      </thingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <thingDefs>
        <li>Hay</li>
      </thingDefs>
    </defaultIngredientFilter>
    <products>
      <Aq_IceBlocks>40</Aq_IceBlocks>
    </products>
  </RecipeDef>
  
</Defs>
