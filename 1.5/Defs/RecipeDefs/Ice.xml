<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Ice Blocks -->
  <RecipeDef>
    <defName>Aq_MakeIceBlocks</defName>
    <label>make ice blocks</label>
    <description>Craft ice blocks from hay using endo-thermic principals.</description>
    <jobString>Making ice blocks.</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <workAmount>1200</workAmount>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <defaultIngredientFilter>
      <thingDefs>
        <li>Hay</li>
      </thingDefs>
    </defaultIngredientFilter>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Hay</li>
          </thingDefs>
        </filter>
        <count>2.0</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Hay</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Aq_IceBlocks>20</Aq_IceBlocks>
    </products>
  </RecipeDef>
  
  <RecipeDef>
    <defName>Aq_MakeIceBlocksBulk</defName>
    <label>make ice blocks in bulk</label>
    <description>Craft ice blocks from hay using endo-thermic principals.</description>
    <jobString>Making ice blocks.</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <workAmount>2100</workAmount>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <defaultIngredientFilter>
      <thingDefs>
        <li>Hay</li>
      </thingDefs>
    </defaultIngredientFilter>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Hay</li>
          </thingDefs>
        </filter>
        <count>4.0</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Hay</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Aq_IceBlocks>40</Aq_IceBlocks>
    </products>
  </RecipeDef>
  
</Defs>
