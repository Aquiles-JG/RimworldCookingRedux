<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <RecipeDef>
    <defName>Aq_MakeCandy</defName>
    <label>make candy</label>
    <description>Make four candies.</description>
    <jobString>Making candy.</jobString>
    <workAmount>1200</workAmount>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Aq_Fruit</li>
          </categories>
          <thingDefs>
            <li>Aq_Honey</li>
          </thingDefs>
        </filter>
        <count>0.9</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_MintSyrup</li>
            <li>Aq_SodaSyrup</li>
            <li>Aq_SweetSyrup</li>
          </thingDefs>
        </filter>
        <count>0.3</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Aq_Fruit</li>
      </categories>
      <thingDefs>
        <li>Aq_Honey</li>
        <li>Aq_MintSyrup</li>
        <li>Aq_SodaSyrup</li>
        <li>Aq_SweetSyrup</li>
      </thingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <categories>
        <li>Aq_Fruit</li>
      </categories>
      <thingDefs>
        <li>Aq_MintSyrup</li>
        <li>Aq_SodaSyrup</li>
        <li>Aq_SweetSyrup</li>
      </thingDefs>
      <disallowedThingDefs>
        <li>Aq_Honey</li>
      </disallowedThingDefs>
    </defaultIngredientFilter>
    <products>
      <Aq_Candy>4</Aq_Candy>
    </products>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <skillRequirements>
      <Cooking>4</Cooking>
    </skillRequirements>
    <recipeUsers>
      <li>Aq_CandyCooker</li>
    </recipeUsers>
    <researchPrerequisites>
      <li>Aq_BakeryIV</li>
    </researchPrerequisites>
  </RecipeDef>
  
  <RecipeDef>
    <defName>Aq_BakeCookies</defName>
    <label>bake cookies</label>
    <description>Bake four cookies.</description>
    <jobString>Baking cooking.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_Flour</li>
          </thingDefs>
        </filter>
        <count>0.9</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Chocolate</li>
            <li>Aq_Butter</li>
          </thingDefs>
        </filter>
        <count>0.3</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Aq_Flour</li>
        <li>Chocolate</li>
        <li>Aq_Butter</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Aq_Cookies>4</Aq_Cookies>
    </products>
    <workSkill>Cooking</workSkill>
    <recipeUsers>
      <li>Aq_CandyCooker</li>
    </recipeUsers>
    <skillRequirements>
      <Cooking>4</Cooking>
    </skillRequirements>
    <researchPrerequisites>
      <li>Aq_BakeryIV</li>
    </researchPrerequisites>
  </RecipeDef>
  
  <RecipeDef>
    <defName>Aq_BakeMintCreamCookie</defName>
    <label>bake mint cream cookie</label>
    <description>Bake three chocolate cookies with mint cream filling.</description>
    <jobString>Baking cookie.</jobString>
    <workAmount>1800</workAmount>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>CookingRedux.IngredientValueGetter_NutritionWithExtraIngredient</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Chocolate</li>
            <li>Aq_Cream</li>
          </thingDefs>
        </filter>
        <count>2.1</count>
        <!-- It's 2.1 and not 2.0 because it needs be multipliable by 0.3-->
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_MintLeaves</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Aq_MintLeaves</li>
        <li>Chocolate</li>
        <li>Aq_Cream</li>
      </thingDefs>
      <specialFiltersToDisallow>
        <li>AllowRotten</li>
      </specialFiltersToDisallow>
    </fixedIngredientFilter>
    <products>
      <Aq_MintCreamCookie>3</Aq_MintCreamCookie>
    </products>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <skillRequirements>
      <Cooking>6</Cooking>
    </skillRequirements>
    <recipeUsers>
      <li>Aq_CandyCooker</li>
    </recipeUsers>
    <researchPrerequisites>
      <li>Aq_BakeryIV</li>
    </researchPrerequisites>
  </RecipeDef>
  
</Defs>
