<?xml version="1.0" encoding="utf-8"?>
<Defs>

<RecipeDef>
	<defName>Aq_MakeHotDog</defName>
	<label>make hot dog</label>
	<description>Make four hot dogs.</description>
	<jobString>Making hot dogs.</jobString>
    <workAmount>1200</workAmount>
	<allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
	<fixedIngredientFilter>
			<thingDefs>
				<li>Aq_Bread</li>
				<li>Aq_Flour</li>
				<li>Sausage_Raw</li>
				<li>Aq_Sausages</li>
			</thingDefs>
	</fixedIngredientFilter>
	<defaultIngredientFilter>
			<thingDefs>
				<li>Aq_Bread</li>
				<li>Sausage_Raw</li>
				<li>Aq_Sausages</li>
			</thingDefs>
			<disallowedThingDefs>
				<li>Aq_Flour</li>
			</disallowedThingDefs>		
   </defaultIngredientFilter>
   <ingredients>
   			<li>
				<filter>
					<thingDefs>
						<li>Aq_Bread</li>
						<li>Aq_Flour</li>
					</thingDefs>
				</filter>
				<count>1.2</count>	<!-- 2.1 instead of 2.0 so it can be easily divided by 3-->
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Sausage_Raw</li>
						<li>Aq_Sausages</li>
					</thingDefs>
				</filter>
				<count>0.9</count>
			</li>
  </ingredients>
	<products>
	  <Aq_HotDog>4</Aq_HotDog>
	</products>
	<workSpeedStat>CookSpeed</workSpeedStat>
      <workSkill>Cooking</workSkill>
       <requiredGiverWorkType>Cooking</requiredGiverWorkType>
      <effectWorking>Cook</effectWorking>
   	 <soundWorking>Recipe_CookMeal</soundWorking>
      <recipeUsers>
        <li>Aq_Grill</li>
        <li>Aq_ChemfuelGrill</li>
      </recipeUsers>
      <skillRequirements>
		<Cooking>4</Cooking>
	</skillRequirements>
      <researchPrerequisites>
			<li>Aq_Sandwiches</li>
			<li>Electricity</li>   <!-- To make it an Industrial-era food-->
		</researchPrerequisites> 
</RecipeDef>

