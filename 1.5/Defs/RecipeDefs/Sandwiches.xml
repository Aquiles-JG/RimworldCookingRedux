  <RecipeDef>
	<defName>Aq_MakeCheeseSandwich</defName>
	<label>make cheesesteak sandwich</label>
	<description>Make three cheesesteak sandwiches.</description>
	<jobString>Making cheesesteak sandwiches.</jobString>
    <workAmount>1800</workAmount>
	<allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
	
	<fixedIngredientFilter>
			<categories>
				<li>MeatRaw</li>
			</categories>
			<thingDefs>
				<li>Aq_Bread</li>
				<li>Aq_Cheese</li>
				<li>Aq_VegCheese</li>
			</thingDefs>
	</fixedIngredientFilter>
	<defaultIngredientFilter>
			<categories>
				<li>MeatRaw</li>
			</categories>
			<thingDefs>
				<li>Aq_Bread</li>
				<li>Aq_Cheese</li>
				<li>Aq_VegCheese</li>
			</thingDefs>
			<disallowedThingDefs>
				<li>Aq_Flour</li>
				<li>Meat_Human</li>
				<li>Meat_Megaspider</li>
				<li MayRequire="Ludeon.Rimworld.Anomaly">Meat_Twisted</li>
				<li>Sausage_Raw</li>
			</disallowedThingDefs>			
   </defaultIngredientFilter>
   <ingredients>
   			<li>
				<filter>
					<thingDefs>
						<li>Aq_Bread</li>
					</thingDefs>
				</filter>
				<count>0.9</count>
			</li>
			<li>
				<filter>
					<categories>
						<li>MeatRaw</li>
					</categories>
				</filter>
				<count>1.2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Aq_Cheese</li>
						<li>Aq_VegCheese</li>
					</thingDefs>
				</filter>
				<count>0.9</count>
			</li>
		
  </ingredients>
	
	<products>
	  <Aq_CheeseSandwich>3</Aq_CheeseSandwich>
	</products>
	<workSpeedStat>CookSpeed</workSpeedStat>
      <workSkill>Cooking</workSkill>
      <effectWorking>Cook</effectWorking>
   	 <soundWorking>Recipe_CookMeal</soundWorking>
      <recipeUsers>
        <li>Aq_Grill</li>
        <li>Aq_ChemfuelGrill</li>
      </recipeUsers>
      <skillRequirements>
		<Cooking>6</Cooking>
	</skillRequirements>
      <researchPrerequisites>
		<li>Aq_Sandwiches</li>
	  </researchPrerequisites>
      
</RecipeDef>



</Defs>