<?xml version="1.0" encoding="utf-8"?>
<Defs>

<RecipeDef>
    <defName>Aq_CookHotPot</defName>
    <label>cook hot pot</label>
    <description>Cook a hot pot mixing practically everything in boiling water with some broth. The only single meal recipe. Convenient for one man scenarios or rough starts.</description>
    <jobString>Cooking hot pot.</jobString>
    <workAmount>300</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
	<fixedIngredientFilter>
			<categories>
				<li>MeatRaw</li>
				<li>PlantFoodRaw</li>
				<li>AnimalProductRaw</li>
				<li>MealBasic</li>
			</categories>
			<thingDefs>
				<li MayRequire="Aquiles.alchemy">Aq_Marrow</li>
		    </thingDefs>
			<disallowedThingDefs>
				<li>HemogenPack</li>
				<li MayRequire="Aquiles.Elves">DE_Blood</li>
				<li MayRequire="Aquiles.Elves">Aq_TrollBlood</li>
				<li MayRequire="Aquiles.alchemy">Aq_Fat</li>
				<li MayRequire="Aquiles.alchemy">Aq_RustAntennae</li>
			</disallowedThingDefs>		
	</fixedIngredientFilter>
	<defaultIngredientFilter>
			<categories>
				<li>MeatRaw</li>
				<li>PlantFoodRaw</li>
				<li>AnimalProductRaw</li>
			</categories>
			<disallowedCategories>
				<li>MealBasic</li>
				<li>EggsFertilized</li>
			</disallowedCategories>
			<thingDefs>
				<li MayRequire="Aquiles.alchemy">Aq_Marrow</li>
		    </thingDefs>	
			<disallowedThingDefs>
				<li>Meat_Megaspider</li>
				<li>Meat_Human</li>
				<li MayRequire="Ludeon.Rimworld.Anomaly">Meat_Twisted</li>
				<li>Sausage_Raw</li>
				<li>Aq_RawHoney</li>
				<li MayRequire="Aquiles.Humanoids">Aq_GorgonHeart</li>
			</disallowedThingDefs>		
   </defaultIngredientFilter>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
            <li>PlantFoodRaw</li>
            <li>AnimalProductRaw</li>
            <li>MealBasic</li>
          </categories>
          <thingDefs>
				<li MayRequire="Aquiles.alchemy">Aq_Marrow</li>
		  </thingDefs>
          <disallowedThingDefs>
			<li>HemogenPack</li>
			<li MayRequire="Aquiles.Elves">DE_Blood</li>
			<li MayRequire="Aquiles.alchemy">Aq_Fat</li>
		  </disallowedThingDefs>		
        </filter>
        <count>0.5</count>
      </li>
    </ingredients>
    <products>
      <Aq_HotPot>1</Aq_HotPot>
    </products>
    <workSkill>Cooking</workSkill>
    <recipeUsers>
        <li>Campfire</li>
        <li>ElectricStove</li>
        <li>FueledStove</li>
    </recipeUsers>
  </RecipeDef>

