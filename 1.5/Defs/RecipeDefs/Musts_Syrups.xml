	<RecipeDef>
		<defName>Aq_MakeMustWine</defName>
		<label>make grape must</label>
		<description>Make grape must by crushing grapes. Needs to undergo fermentation in order to become wine.</description>
		<jobString>Making grape must.</jobString>
		<workSpeedStat>DrugCookingSpeed</workSpeedStat>
		<workSkill>Cooking</workSkill>
		<effectWorking>Cook</effectWorking>
		<workAmount>1000</workAmount>
		<soundWorking>Recipe_Brewing</soundWorking>
		<recipeUsers>
			<li>Brewery</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Aq_RawGrapes</li>
					</thingDefs>
				</filter>
				<count>25</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Aq_RawGrapes</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Aq_WineMust>5</Aq_WineMust>
		</products>
		<skillRequirements>
			<Cooking>4</Cooking>
		</skillRequirements>
		<researchPrerequisite>Aq_WineMaking</researchPrerequisite>
	</RecipeDef>


</Defs>