<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--  Butter -->
  <RecipeDef>
    <defName>Aq_ChurnButter</defName>
    <label>make butter</label>
    <description>Make butter using a churn.</description>
    <jobString>Churning butter.</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Brewing</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <workAmount>800</workAmount>
   <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Milk</li>
            <li>Aq_VegMilk</li>
          </thingDefs>
        </filter>
        <count>1.2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Milk</li>
        <li>Aq_VegMilk</li>
      </thingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
	  <thingDefs>
        <li>Milk</li>
      </thingDefs>
      <disallowedThingDefs>
		 <li>Aq_VegMilk</li>
	  </disallowedThingDefs>	
   </defaultIngredientFilter>
    <products>
      <Aq_Butter>4</Aq_Butter>
    </products>
    <recipeUsers>
      <li>Aq_Churn</li>
      <li>Aq_ElectricChurn</li>	
    </recipeUsers>
    <researchPrerequisite>Aq_ButterMaking</researchPrerequisite>
  </RecipeDef>
  
  <!--  Cream -->
  <RecipeDef>
    <defName>Aq_ChurnCream</defName>
    <label>make cream</label>
    <description>Make cream using a churn.</description>
    <jobString>Churning cream.</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Brewing</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <workAmount>800</workAmount>
    <ingredientValueGetterClass>CookingRedux.IngredientValueGetter_NutritionWithExtraIngredient</ingredientValueGetterClass>
    
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Milk</li>
          </thingDefs>
        </filter>
        <count>1.2</count>
      </li>
       <li>
        <filter>
           <thingDefs>
             <li>Aq_Sugar</li>
           </thingDefs>
        </filter>
           <count>2</count>
       </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Milk</li>
        <li>Aq_Sugar</li>
      </thingDefs>
    </fixedIngredientFilter>
   <defaultIngredientFilter>
	  <thingDefs>
        <li>Milk</li>
        <li>Aq_Sugar</li>
      </thingDefs>
   </defaultIngredientFilter>
   
    <products>
      <Aq_Cream>4</Aq_Cream>
    </products>
    <recipeUsers>
      <li>Aq_Churn</li>
      <li>Aq_ElectricChurn</li>	
    </recipeUsers>
    <researchPrerequisite>Aq_ButterMaking</researchPrerequisite>
  </RecipeDef>
  
   <!--  Honey -->
  <RecipeDef>
    <defName>Aq_ChurnHoney</defName>
    <label>extract honey</label>
    <description>Extract honey using a churn.</description>
    <jobString>Extracting honey.</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Brewing</soundWorking>
    <allowMixingIngredients>false</allowMixingIngredients>
    <workAmount>800</workAmount>
   
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_RawHoney</li>
          </thingDefs>
        </filter>
        <count>1.2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Aq_RawHoney</li>
      </thingDefs>
    </fixedIngredientFilter>
   <defaultIngredientFilter>
	  <thingDefs>
        <li>Aq_RawHoney</li>
      </thingDefs>
   </defaultIngredientFilter>
    <products>
      <Aq_Honey>4</Aq_Honey>
    </products>
    <recipeUsers>
      <li>Aq_Churn</li>
      <li>Aq_ElectricChurn</li>	
    </recipeUsers>
    <researchPrerequisite>Aq_HoneyMaking</researchPrerequisite>
  </RecipeDef>
  
 
</Defs>