<Defs>

<!-- BREADS: Cinnamon Bread --> 
  <HediffDef>
	<defName>TooDelicious</defName>
	<label>Ate a cinnamon bread</label>
	<description>So satisfying I feel revitalized.</description>
  	<defaultLabelColor>(0, 0.75, 0.05)</defaultLabelColor>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
	<initialSeverity>1</initialSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.0</severityPerDay>
      </li>
    </comps>
    <stages>
        <li>
         <restFallFactor>0.9</restFallFactor>
          <minSeverity>0</minSeverity>
          <label>Food</label>
            <capMods>
              <li>
                <capacity>BloodPumping</capacity>
                <offset>0.1</offset>
              </li>
               <li>
                <capacity>BloodFiltration</capacity>
                <offset>0.05</offset>
              </li>
            </capMods>
        </li>
      </stages>
  </HediffDef>

