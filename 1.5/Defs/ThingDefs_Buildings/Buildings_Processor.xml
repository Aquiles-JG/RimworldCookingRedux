<Defs>
  
  <ThingDef ParentName="BuildingBase">
    <defName>Aq_CheesePress</defName>
    <label>cheese press</label>
    <description>A cheese press is a device for pressing whey from curds when making cheese. Pressing influences the cheese's hardness and texture and will also determine the shape of the block or wheel of cheese.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <drawSize>(1.3,1.3)</drawSize>
      <texPath>Things/Building/Aq_CheesePress</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <damageData>
        <rect>(0.05,0.1,0.9,0.9)</rect>
      </damageData>
      <shadowData>
        <volume>(0.75, 0.35, 0.33)</volume>
      </shadowData>
    </graphicData>
    <neverMultiSelect>true</neverMultiSelect>
    <minifiedDef>MinifiedThing</minifiedDef>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.45</fillPercent>
    <pathCost>60</pathCost>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <statBases>
      <WorkToBuild>600</WorkToBuild>
      <Mass>10</Mass>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <Steel>10</Steel>
      <WoodLog>50</WoodLog>
    </costList>
    <constructEffect>ConstructWood</constructEffect>
    <uiIconScale>0.8</uiIconScale>
    <size>(1,1)</size>
    <tickerType>Rare</tickerType>
    <rotatable>true</rotatable>
    <designationCategory>Production</designationCategory>
    <researchPrerequisites>
      <li>Aq_CheeseMaking</li>
    </researchPrerequisites>
    <comps>
      <li Class="ProcessorFramework.CompProperties_Processor">
        <capacity>20</capacity>
        <independentProcesses>true</independentProcesses>
        <processes>
          <li>Aq_Cheese</li>
          <li>Aq_VegCheese</li>
        </processes>
      </li>
    </comps>
  </ThingDef>
  
