<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>Aq_EvaporationPond</defName>
    <label>evaporation pond</label>
    <description>A pond for letting seawater evaporate, leaving behind its delicious rock salt. It provides 10 salt after several days.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/EvaporationPond</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
	<pathCost>50</pathCost>
	<terrainAffordanceNeeded></terrainAffordanceNeeded>
    <blockWind>false</blockWind>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <fillPercent>1</fillPercent>
    <blockLight>true</blockLight>
    <canOverlapZones>false</canOverlapZones>
    <costStuffCount>150</costStuffCount>
    <stuffCategories>
      	<li>Woody</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <tickerType>Normal</tickerType>
    <size>(3,3)</size>
    <comps>
      <li Class="CompProperties_Spawner">
		<compClass>EvaporationPond.CompSpawner</compClass>
        <thingToSpawn>Aq_Salt</thingToSpawn>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
        <spawnCount>10</spawnCount>
        <spawnIntervalRange>360000~480000</spawnIntervalRange>
        <spawnMaxAdjacent>40</spawnMaxAdjacent>
        <spawnForbidden>true</spawnForbidden>
        <saveKeysPrefix>Aq_Salt</saveKeysPrefix>
      </li>
    </comps>
    <rotatable>false</rotatable>
    <placeWorkers>
		<li>EvaporationPond.PlaceWorker_EvaporationPond</li>
	</placeWorkers>
    <designationCategory>Production</designationCategory>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <soundAmbient>WaterMill_Ambience</soundAmbient>
    </building>
    <researchPrerequisites>
	   <li>Aq_Salting</li>
	</researchPrerequisites>
  </ThingDef>
  
   <!-- Ice Hole -->
  <ThingDef ParentName="BenchBase">
    <defName>Aq_IceHole</defName>
    <label>ice hole</label>
    <thingClass>Building_WorkTable</thingClass>
    <description>Originally developed by the ancient Greeks, co-opted by the Romans, and used throughout the Medieval and modern era. Various methods exist that use endothermic principals to create ice from the evaporation of water.</description>
    <size>(1,1)</size>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Aq_IceHole</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.2,1.2)</drawSize>	  
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
        <edgeTop>Damage/Edge</edgeTop>
        <edgeBot>Damage/Edge</edgeBot>
        <edgeLeft>Damage/Edge</edgeLeft>
        <edgeRight>Damage/Edge</edgeRight>
      </damageData>
    </graphicData>
	<uiIconPath>Things/Building/Aq_IceHole</uiIconPath>		
	<costList>
	  <ComponentIndustrial>1</ComponentIndustrial>	
      <Hay>50</Hay>
    </costList>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <constructEffect>ConstructWood</constructEffect>
    <fillPercent>0.1</fillPercent>
    <statBases>
        <WorkToBuild>400</WorkToBuild>
		<MaxHitPoints>50</MaxHitPoints>
		<Mass>40</Mass>	  
    </statBases>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,1)</interactionCellOffset>
    <recipes>
      <li>Aq_MakeIceBlocks</li>
      <li>Aq_MakeIceBlocksBulk</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <designationCategory>Production</designationCategory>
    <terrainAffordanceNeeded>Diggable</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Aq_IceMaking</li>
    </researchPrerequisites>
  </ThingDef>
  
</Defs>
