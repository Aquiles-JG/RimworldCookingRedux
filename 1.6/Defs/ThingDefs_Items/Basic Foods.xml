<ThingDef ParentName="OrganicProductBase">
		<defName>Aq_Cheese</defName>
		<label>cheese</label>
		<description>Cheese is a dairy product, derived from milk and produced in a wide range of flavors, textures and forms by coagulation of the milk protein casein.</description>
		<graphicData>
			<texPath>Things/Item/Aq_Cheese</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<stackLimit>25</stackLimit>
		<statBases>
		 	<Mass>0.25</Mass>
        	<MaxHitPoints>50</MaxHitPoints>
        	<Flammability>1.0</Flammability>
			<MarketValue>10</MarketValue>
			<Nutrition>0.3</Nutrition>
		</statBases>
		<thingCategories>
			<li>MealBasic</li>
		</thingCategories>
		<socialPropernessMatters>true</socialPropernessMatters>
		<ingestible>
			<foodType>Meal</foodType>
    	  	<preferability>RawTasty</preferability>
          	<joyKind>Gluttonous</joyKind>
		  	<joy>0.04</joy>     
          	<ingestEffect>EatVegetarian</ingestEffect>
			<ingestSound>Meal_Eat</ingestSound>
			<maxNumToIngestAtOnce>3</maxNumToIngestAtOnce>
			<defaultNumToIngestAtOnce>3</defaultNumToIngestAtOnce>
      		<optimalityOffsetHumanlikes>12</optimalityOffsetHumanlikes>
		</ingestible>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>90</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
		<tradeTags>
      		<li>Aq_BasicFoods</li>
    	</tradeTags>
    	<researchPrerequisites>			
      		<li>Aq_CheeseMaking</li>
    	</researchPrerequisites>
</ThingDef>

<ThingDef ParentName="OrganicProductBase">
		<defName>Aq_VegCheese</defName>
		<label>vegan cheese</label>
		<description>This cheese is made with almond milk, so it is completely acceptable in a strict vegetarian diet or for anybody suffering of lactose problems. It is more expensive than regular cheese but not nearly as long-lasting.</description>
		<graphicData>
			<texPath>Things/Item/Aq_VegCheese</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<stackLimit>25</stackLimit>
		<statBases>
		 	<Mass>0.25</Mass>
        	<MaxHitPoints>50</MaxHitPoints>
        	<Flammability>1.0</Flammability>
			<MarketValue>13.5</MarketValue>
			<Nutrition>0.3</Nutrition>
		</statBases>
		<thingCategories>
			<li>MealBasic</li>
		</thingCategories>
		<socialPropernessMatters>true</socialPropernessMatters>
		<ingestible>
			<foodType>Meal</foodType>
    	  	<preferability>RawTasty</preferability>
          	<joyKind>Gluttonous</joyKind>
		  	<joy>0.04</joy>     
          	<ingestEffect>EatVegetarian</ingestEffect>
			<ingestSound>Meal_Eat</ingestSound>
			<maxNumToIngestAtOnce>3</maxNumToIngestAtOnce>
			<defaultNumToIngestAtOnce>3</defaultNumToIngestAtOnce>
      		<optimalityOffsetHumanlikes>12</optimalityOffsetHumanlikes>
		</ingestible>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>10</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
			<li Class="CompProperties_Ingredients">
        		<noIngredientsFoodKind>NonMeat</noIngredientsFoodKind>
      		</li>
		</comps>
		<tradeTags>
      		<li>Aq_BasicFoods</li>
    	</tradeTags>
    	<researchPrerequisites>			<!-- Research Prerequisites here to link it to the almond milk-->
      		<li>Aq_VegetableMilk</li>
    	</researchPrerequisites>
</ThingDef>	
	
