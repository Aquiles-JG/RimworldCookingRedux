<Defs>
   
<ThingDef ParentName="OrganicProductBase">
      <defName>Aq_Butter</defName>
      <label>butter</label>
      <description>A large chunk of butter.</description>
      <graphicData>
      	<texPath>Things/Item/Aq_Butter</texPath>
      	<graphicClass>Graphic_Single</graphicClass>
      </graphicData>
    <statBases>
        <Mass>0.21</Mass>
        <MaxHitPoints>50</MaxHitPoints>
        <Flammability>1.0</Flammability>
        <MarketValue>11.4</MarketValue>
        <Nutrition>0.3</Nutrition>
    </statBases>
    <stackLimit>25</stackLimit>
    <thingCategories>
            <li>MealBasic</li>
    </thingCategories>
    <comps>
            <li Class="CompProperties_Rottable">
                <daysToRotStart>7</daysToRotStart>
                <rotDestroys>true</rotDestroys>
            </li>
    </comps>
	<socialPropernessMatters>true</socialPropernessMatters>
	<tradeTags>
      		<li>Aq_BasicFoods</li>
    </tradeTags> 
    <ingestible>
    	  <foodType>Meal</foodType>
    	  <preferability>RawTasty</preferability>
          <joyKind>Gluttonous</joyKind>
		  <joy>0.04</joy>     
          <ingestEffect>EatVegetarian</ingestEffect>
          <ingestSound>Meal_Eat</ingestSound>
          <maxNumToIngestAtOnce>3</maxNumToIngestAtOnce>
      	  <optimalityOffsetHumanlikes>8</optimalityOffsetHumanlikes>
    </ingestible>
</ThingDef>

