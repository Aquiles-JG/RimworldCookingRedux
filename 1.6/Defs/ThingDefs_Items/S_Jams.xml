<?xml version="1.0" encoding="utf-8"?>
<Defs>



  <!-- Strawberry Jam -->
	<ThingDef ParentName="OrganicProductBase">
        <defName>Aq_StrawberryJam</defName>
        <label>strawberry jam</label>
        <description>Strawberries that have been crushed or chopped and cooked with sugar until the pieces of fruit are soft and lose their shape. It lasts a whole season without a freezer.</description>
        <graphicData>
            <texPath>Things/Items/Jams/StrawberryJam</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <MarketValue>11.1</MarketValue>
            <Mass>0.44</Mass>
            <MaxHitPoints>50</MaxHitPoints>
            <Flammability>1.0</Flammability>
            <Nutrition>0.7</Nutrition>
            <FoodPoisonChanceFixedHuman>0.015</FoodPoisonChanceFixedHuman>
        </statBases>
        <stackLimit>10</stackLimit>
        <thingCategories>
            <li>FoodMeals</li>
        </thingCategories>
        <comps>
            <li Class="CompProperties_Rottable">
                <daysToRotStart>15</daysToRotStart>
                <rotDestroys>true</rotDestroys>
            </li>
        </comps>
        <socialPropernessMatters>true</socialPropernessMatters>
        <ingestible>
            <foodType>Meal</foodType>
            <preferability>MealSimple</preferability>
            <joyKind>Gluttonous</joyKind>
		    <joy>0.15</joy>
		    <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
            <ingestEffect>EatVegetarian</ingestEffect>
      		<ingestSound>RawVegetable_Eat</ingestSound>
        </ingestible>
        <tradeTags>
      		<li>Aq_Foods</li>
    	</tradeTags>
    	
    </ThingDef>
    
