<?xml version="1.0" encoding="utf-8"?>
<Defs>

<!-- Hot Chocolate-->
 <ThingDef ParentName="DrugBase">
    <defName>Aq_HotChocolate</defName>
    <label>hot chocolate</label>
    <description>A rich hot drink prepared from powdered cocoa beans, drinking it often leaves the consumer feeling relaxed and contented.</description>
    <graphicData>
      <texPath>Things/Item/Drinks/Aq_HotChocolate</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <thingCategories Inherit="False">
		<li>Aq_DrinksNonAlcoholic</li>
	</thingCategories>
	<rotatable>false</rotatable>
	<stackLimit>25</stackLimit>
    <statBases>
      <MarketValue>10</MarketValue>
      <Mass>0.1</Mass>
      <DeteriorationRate>0.5</DeteriorationRate>
      <Flammability>0.5</Flammability>
      <Nutrition>0.08</Nutrition>
    </statBases>
    <ingestible>
			<foodType>Fluid, Processed</foodType>
			<joyKind>Gluttonous</joyKind>
			<joy>0.16</joy>     
			<drugCategory>Social</drugCategory>
			<ingestSound>Ingest_Drink</ingestSound>
			<ingestHoldOffsetStanding>
				<northDefault>
					<offset>(0.18,0,0)</offset>
				</northDefault>
			</ingestHoldOffsetStanding>
			<ingestCommandString>Drink {0}</ingestCommandString>
			<ingestReportString>Drinking {0}.</ingestReportString>
			<ingestHoldUsesTable>false</ingestHoldUsesTable>
			<tasteThought>Aq_DrankHotChoco</tasteThought>
	</ingestible>
    <techLevel>Neolithic</techLevel>
    <comps>
      <li Class="CompProperties_Drug">
        <listOrder>998</listOrder>
        <teetotalerCanConsume>true</teetotalerCanConsume>
        <overdoseSeverityOffset>0</overdoseSeverityOffset>
      </li>
    </comps>
    <tradeTags>
      	<li>Aq_Foods</li>
    </tradeTags>
  </ThingDef>
  
