<?xml version="1.0" encoding="utf-8"?>
<Defs>
		
	<ThingDef ParentName="MealCooked">
		<!-- Basic Properties -->
		<defName>Aq_HotDog</defName>
		<label>hot dog</label>
		<description>A frankfurter served hot in a long, soft roll and topped occasionally with various condiments. It improves sight for a brief period of time.</description>
		<!-- Graphic -->
		<graphicData>	
			<texPath>Things/Items/HotDog</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<!-- Properties -->
		<statBases>
			<MarketValue>15.5</MarketValue>
			<Nutrition>0.9</Nutrition>	
		</statBases>
		<ingestible>
			<preferability>MealSimple</preferability>
			<tasteThought>Aq_AteHotDog</tasteThought>
			<maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
			<outcomeDoers>
					<li Class="IngestionOutcomeDoer_GiveHediff">
					<hediffDef>Aq_AteHotDog</hediffDef>
					<severity>0.25</severity>
					</li>
			</outcomeDoers>
		</ingestible>
		<tradeTags>
      		<li>Aq_Foods</li>
    	</tradeTags>
	</ThingDef>
	
