<?xml version="1.0" encoding="utf-8"?>
<Defs>
   	<!-- Ice blocks -->
	<ThingDef ParentName="ResourceBase">
    <defName>Aq_BlocksIce</defName>
    <label>ice blocks</label>
    <description>Water which has been frozen to create ice, unbelievably an extremely valuable resource, especially in hot environments. Careful as ice tends to melt at above 1ºC.</description>
    <graphicData>
      <texPath>Things/Items/Resource/BlocksIce</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <statBases>
      <MaxHitPoints>30</MaxHitPoints>
      <Mass>1.35</Mass>
      <MarketValue>1.25</MarketValue>
      <DeteriorationRate>15</DeteriorationRate>
    </statBases>
    <tickerType>Rare</tickerType>		
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>1</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="CompProperties_HeatPusher">
		<compClass>CompHeatPusher</compClass>
		<heatPerSecond>-1</heatPerSecond>
		<heatPushMaxTemperature>1</heatPushMaxTemperature>
	  </li>
    </comps>	
  </ThingDef> 
  
</Defs>