<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="RoughPlantBase">
		<defName>Aq_RawCoffee</defName>
		<label>coffee beans</label>
		<description>The pits of coffee plant berries, known succinctly as “coffee beans”. They can be roasted to bring out a robust and bitter flavor, as well as natural caffeine.</description>
		<graphicData>
			<texPath>Things/Item/Raw/Aq_CoffeeBeans</texPath>
		</graphicData>
		<statBases>
			<MarketValue>1.1</MarketValue>
			<Flammability>1.3</Flammability>
		</statBases>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>60</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
		<thingCategories>
			<li>PlantMatter</li>
		</thingCategories>
		<ingestible>
			<preferability>DesperateOnly</preferability>
		</ingestible>
	</ThingDef>
	
	<ThingDef ParentName="RoughPlantBase">
		<defName>Aq_RawTea</defName>
		<label>tea leaves</label>
		<description>The leaves of the tea plant. They can be boiled into a variety of earthy and soothing beverages.</description>
		<graphicData>
			<texPath>Things/Item/Raw/Aq_TeaLeaves</texPath>
		</graphicData>
		<statBases>
			<MarketValue>1.1</MarketValue>
			<Flammability>1.3</Flammability>
		</statBases>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>15</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
		<thingCategories>
			<li>PlantMatter</li>
		</thingCategories>
		<ingestible>
			<preferability>DesperateOnly</preferability>
		</ingestible>
	</ThingDef>
	
</Defs>