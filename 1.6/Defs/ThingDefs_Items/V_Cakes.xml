<?xml version="1.0" encoding="utf-8"?>
<Defs>
   
  
	<ThingDef ParentName="MealCooked">
      <defName>Aq_Cheesecake</defName>
      <label>cheesecake</label>
      <description>A slice of a marvellous cheesecake. It decreases hunger rate and the mental break threshold for a short period of time.</description>
      <graphicData>
         <texPath>Things/Item/Cakes/Cheesecake</texPath>
         <graphicClass>Graphic_Single</graphicClass>
      </graphicData>
      <statBases>
         <DeteriorationRate>7.5</DeteriorationRate>
         <MarketValue>20.15</MarketValue>
         <Beauty>0</Beauty>
         <Nutrition>0.7</Nutrition>
         <Mass>0.44</Mass>
      </statBases>
      <ingestible>   
         <preferability>MealFine</preferability>
         <joy>0.5</joy>
         <ingestEffect>EatVegetarian</ingestEffect>
         <ingestSound>Meal_Eat</ingestSound>
      	 <joyKind>Gluttonous</joyKind>
      	 <tasteThought>Aq_AteCheesecake</tasteThought>
      	 <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      	 <outcomeDoers>
			<li Class="IngestionOutcomeDoer_GiveHediff">
		 	<hediffDef>Aq_AteCheesecake</hediffDef>
		 	<severity>0.25</severity>
			</li>
		</outcomeDoers>
      </ingestible>
      <tradeTags>
      		<li>Aq_Foods</li>
      </tradeTags>   
   </ThingDef>
   
