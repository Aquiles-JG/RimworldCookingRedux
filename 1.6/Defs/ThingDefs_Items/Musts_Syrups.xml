  <ThingDef ParentName="Aq_SyrupBase">
    <defName>Aq_ColaSyrup</defName>
    <label>cola syrup</label>
    <description>A thick and disgustingly sweet mixture derived straight from cane sugar. Must be cut with water and left to carbonate briefly in a sealed environment before consumption. Can be eaten raw, but the sugar rush is almost guaranteed.</description>
    <graphicData>
      <texPath>Things/Items/Musts/Aq_ColaSyrup</texPath>
    </graphicData>
    <statBases>
      <MarketValue>2.5</MarketValue>
    </statBases>
  </ThingDef>
  
