<?xml version="1.0" encoding="utf-8"?>
<Defs>

     <RecipeDef Name="Aq_MakeFlour" Abstract="True">
        <defName>Aq_MakeFlour</defName>
        <label>make flour</label>
        <description>Turn raw grains into flour.</description>
        <jobString>Grinding grains.</jobString>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Cooking</workSkill>
        <effectWorking>Cook</effectWorking>
        <soundWorking>Recipe_Grind</soundWorking>
        <researchPrerequisite>Aq_BreadMaking</researchPrerequisite>
    </RecipeDef>

    <RecipeDef ParentName="Aq_MakeFlour">
        <defName>Aq_MillGrains</defName>
        <label>make flour</label>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Aq_RawWheat</li>
                        <li>RawCorn</li>
                		<li>RawRice</li>
                    </thingDefs>
                </filter>
                <count>5</count>
            </li>
        </ingredients>
        <defaultIngredientFilter>
        	<thingDefs>
                <li>Aq_RawWheat</li>
        	</thingDefs>
            <disallowedThingDefs>
        		<li>RawCorn</li>
             	<li>RawRice</li>
            </disallowedThingDefs>
        </defaultIngredientFilter>  
         <fixedIngredientFilter>
            <thingDefs>
                <li>Aq_RawWheat</li>
                <li>RawCorn</li>
                <li>RawRice</li>
            </thingDefs>
        </fixedIngredientFilter>     
        <products>
            <Aq_Flour>4</Aq_Flour>
        </products>
        <workAmount>800</workAmount>
    </RecipeDef>

    <RecipeDef ParentName="Aq_MakeFlour">
        <defName>Aq_MillGrains_Bulk</defName>
        <label>make flour in bulk</label>
        <soundWorking>Recipe_Smelt</soundWorking>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Aq_RawWheat</li>
                        <li>RawCorn</li>
                		<li>RawRice</li>
                    </thingDefs>
                </filter>
                <count>25</count>
            </li>
        </ingredients>
        <defaultIngredientFilter>
        	<thingDefs>
                <li>Aq_RawWheat</li>
        	</thingDefs>
        	<disallowedThingDefs>
        		<li>RawCorn</li>
             	<li>RawRice</li>
            </disallowedThingDefs>
        </defaultIngredientFilter>  
         <fixedIngredientFilter>
            <thingDefs>
                <li>Aq_RawWheat</li>
                <li>RawCorn</li>
                <li>RawRice</li>
            </thingDefs>
        </fixedIngredientFilter>
        <products>
            <Aq_Flour>20</Aq_Flour>
        </products>
        <workAmount>1400</workAmount>
    </RecipeDef>
    
    <RecipeDef Name="Aq_MakeSugar" Abstract="True">
        <defName>Aq_MakeSugar</defName>
        <label>make sugar</label>
        <description>Crush the sugarcane until it represents a sand-like substance. It is more time-efficient to do it in bulk.</description>
        <jobString>Grinding sugarcane.</jobString>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Cooking</workSkill>
        <effectWorking>Cook</effectWorking>
        <soundWorking>Recipe_Grind</soundWorking>
        <fixedIngredientFilter>
            <thingDefs>
                <li>Aq_Sugarcane</li>
            </thingDefs>
        </fixedIngredientFilter>
        <researchPrerequisite>Aq_SugarMaking</researchPrerequisite>
    </RecipeDef>

    <RecipeDef ParentName="Aq_MakeSugar">
        <defName>Aq_MakeSugar</defName>
        <label>make sugar</label>
        <workAmount>800</workAmount>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Aq_Sugarcane</li>
                    </thingDefs>
                </filter>
                <count>5</count>
            </li>
        </ingredients>
        <products>
            <Aq_Sugar>4</Aq_Sugar>
        </products>
    </RecipeDef>

    <RecipeDef ParentName="Aq_MakeSugar">
        <defName>Aq_MakeSugar_Bulk</defName>
        <label>make sugar in bulk</label>
        <workAmount>1400</workAmount>
        <soundWorking>Recipe_Smelt</soundWorking>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Aq_Sugarcane</li>
                    </thingDefs>
                </filter>
                <count>25</count>
            </li>
        </ingredients>
        <products>
            <Aq_Sugar>20</Aq_Sugar>
        </products>
    </RecipeDef>

</Defs>