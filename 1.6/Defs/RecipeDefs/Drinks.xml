<?xml version="1.0" encoding="utf-8"?>
<Defs>

<!-- Hot Chocolate-->
 <RecipeDef>
		<defName>Aq_MakeHotChoco</defName>
		<label>make hot chocolate</label>
		<description>Make a rich hot beverage made of chocolate.</description>
		<jobString>Making hot chocolate.</jobString>
		<workSkill>Cooking</workSkill>
		<workSpeedStat>CookSpeed</workSpeedStat>
		<workAmount>600</workAmount>
		<effectWorking>Cook</effectWorking>
		<soundWorking>Recipe_Brewing</soundWorking>
		<allowMixingIngredients>false</allowMixingIngredients>		
		<recipeUsers>
			<li>FueledStove</li>		
			<li>ElectricStove</li>	
			<li>Aq_CandyCooker</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Chocolate</li>
					</thingDefs>
				</filter>
				<count>12</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Milk</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>					
		</ingredients>
		<fixedIngredientFilter>			
			<thingDefs>
				<li>Chocolate</li>
				<li>Milk</li>				
			</thingDefs>
			<categories>				
			</categories>
		</fixedIngredientFilter>
		<defaultIngredientFilter>			
			<thingDefs>
				<li>Chocolate</li>
				<li>Milk</li>		
			</thingDefs>
			<categories>				
			</categories>
		</defaultIngredientFilter>		
		<products>
			<Aq_HotChocolate>4</Aq_HotChocolate>
		</products>
		<researchPrerequisite>Aq_BrewingII</researchPrerequisite>		
	</RecipeDef>
	
	<RecipeDef>
		<defName>Aq_MakeCinnamonMilk</defName>
		<label>make cinnamon milk</label>
		<description>Make cinnamon milk mixing milk, cinnamon sticks and vanilla extract in a small saucepan over a low heat.</description>
		<jobString>Preparing cinnamon milk.</jobString>
		<workSkill>Cooking</workSkill>
		<workSpeedStat>CookSpeed</workSpeedStat>
		<workAmount>800</workAmount>
		<effectWorking>Cook</effectWorking>
		<soundWorking>Recipe_Brewing</soundWorking>
		<allowMixingIngredients>true</allowMixingIngredients>		
		<ingredientValueGetterClass>CookingRedux.IngredientValueGetter_NutritionWithExtraIngredient</ingredientValueGetterClass>	
		<recipeUsers>
			<li>FueledStove</li>		
			<li>ElectricStove</li>		
			<li>Aq_CandyCooker</li>		
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Milk</li>
						<li>Aq_VegMilk</li>
					</thingDefs>
				</filter>
				<count>0.6</count>
			</li>	
			<li>
				<filter>
					<thingDefs>
						<li>Aq_RawCinnamon</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>			
		</ingredients>
		<fixedIngredientFilter>			
			<thingDefs>
				<li>Milk</li>	
				<li>Aq_VegMilk</li>
				<li>Aq_RawCinnamon</li>
			</thingDefs>
			<categories>				
			</categories>
		</fixedIngredientFilter>
		<defaultIngredientFilter>			
			<thingDefs>
				<li>Milk</li>
				<li>Aq_RawCinnamon</li>
			</thingDefs>
			<disallowedThingDefs>
				<li>Aq_VegMilk</li>
			</disallowedThingDefs>
		</defaultIngredientFilter>		
		<products>
			<Aq_CinnamonMilk>4</Aq_CinnamonMilk>
		</products>	
		<researchPrerequisite>Aq_BrewingIII</researchPrerequisite>	
	</RecipeDef>


