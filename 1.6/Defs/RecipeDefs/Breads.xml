<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <RecipeDef>
    <defName>Aq_BakeBread</defName>
    <label>bake bread</label>
    <description>Bake four breads.</description>
    <jobString>Baking bread.</jobString>
    <allowMixingIngredients>false</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <recipeUsers>
      <li>Aq_Oven</li>
      <li>Aq_ElectricOven</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_Flour</li>
          </thingDefs>
        </filter>
        <count>1.2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Aq_Flour</li>
      </thingDefs>
      <specialFiltersToDisallow>
        <li>AllowRotten</li>
      </specialFiltersToDisallow>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <thingDefs>
        <li>Aq_Flour</li>
      </thingDefs>
    </defaultIngredientFilter>
    <products>
      <Aq_Bread>4</Aq_Bread>
    </products>
    <workAmount>800</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <researchPrerequisite>Aq_BreadMaking</researchPrerequisite>
  </RecipeDef>
  
  <RecipeDef>
    <defName>Aq_BakeSweetBread</defName>
    <label>bake sweet bread</label>
    <description>Bake four sweet breads.</description>
    <jobString>Baking sweet bread.</jobString>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>CookingRedux.IngredientValueGetter_NutritionWithExtraIngredient</ingredientValueGetterClass>
    <recipeUsers>
      <li>Aq_Oven</li>
      <li>Aq_ElectricOven</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_Bread</li>
            <li>Aq_Flour</li>
          </thingDefs>
        </filter>
        <count>1.2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_Sugar</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <products>
      <Aq_SweetBread>4</Aq_SweetBread>
    </products>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Aq_Bread</li>
        <li>Aq_Flour</li>
        <li>Aq_Sugar</li>
      </thingDefs>
      <specialFiltersToDisallow>
        <li>AllowRotten</li>
      </specialFiltersToDisallow>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <thingDefs>
        <li>Aq_Bread</li>
        <li>Aq_Sugar</li>
      </thingDefs>
      <disallowedThingDefs>
        <li>Aq_Flour</li>
      </disallowedThingDefs>
    </defaultIngredientFilter>
    <workAmount>1200</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <skillRequirements>
      <Cooking>4</Cooking>
    </skillRequirements>
    <researchPrerequisites>
      <li>Aq_BreadMaking</li>
      <li>Aq_SugarMaking</li>
    </researchPrerequisites>
  </RecipeDef>
  
  <RecipeDef>
