<?xml version="1.0" encoding="utf-8"?>
<Defs>

<RecipeDef>
	<defName>Aq_BakeCheesecake</defName>
	<label>bake cheesecake</label>
	<description>Bake three slices of cheesecake.</description>
	<jobString>Baking cheesecake.</jobString>
    <workAmount>1800</workAmount>
	<allowMixingIngredients>true</allowMixingIngredients>
	<ingredientValueGetterClass>CookingRedux.IngredientValueGetter_NutritionWithExtraIngredient</ingredientValueGetterClass>
	<ingredients>
     <li>
		<filter>
			 <thingDefs>
				<li>Aq_Cheese</li>
				<li>Aq_VegCheese</li>		
			 </thingDefs>
		</filter>
	    <count>0.6</count>
     </li>
      <li>
		<filter>
			 <thingDefs>
				<li>RawBerries</li>
				<li>Aq_RawStrawberries</li>
				<li>Aq_StrawberryJam</li>
			 </thingDefs>
		</filter>
	    <count>1.4</count>
     </li>
      <li>
	    <filter>
	      <thingDefs>
	        <li>Aq_Sugar</li>
	      </thingDefs>
	    </filter>
	    <count>3</count>
	  </li>
	</ingredients>
	<fixedIngredientFilter>
	  <thingDefs>
	    <li>Aq_Sugar</li>
	    <li>Aq_Cheese</li>
	    <li>Aq_VegCheese</li>		
	    <li>RawBerries</li>
	    <li>Aq_RawStrawberries</li>
	    <li>Aq_StrawberryJam</li>
	  </thingDefs>
	</fixedIngredientFilter>
	<products>
	  <Aq_Cheesecake>3</Aq_Cheesecake>
	</products>
	<workSpeedStat>CookSpeed</workSpeedStat>
      <workSkill>Cooking</workSkill>
      <effectWorking>Cook</effectWorking>
   	 <soundWorking>Recipe_CookMeal</soundWorking>
        <skillRequirements>
     		<Cooking>6</Cooking>
    	</skillRequirements>
      <recipeUsers>
        <li>Aq_Oven</li>
        <li>Aq_ElectricOven</li>
      </recipeUsers>
       <researchPrerequisites>
		<li>Aq_BakeryII</li>
	</researchPrerequisites>
</RecipeDef>


