<?xml version="1.0" encoding="utf-8"?>
<Defs>

 <RecipeDef>
	<defName>Aq_BakeMeatloaf</defName>
	<label>bake meatloaf</label>
	<description>Bake three country meatloafs.</description>
	<jobString>Baking meatloafs.</jobString>
    <workAmount>1800</workAmount>
	<allowMixingIngredients>true</allowMixingIngredients>
	<ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
	<fixedIngredientFilter>
			<categories>
				<li>MeatRaw</li>
			</categories>
			<thingDefs>
				<li>Aq_RawGarlic</li>
				<li>Aq_BoiledEgg</li>
				<li>Aq_RawCarrots</li>
			</thingDefs>
	</fixedIngredientFilter>
	<defaultIngredientFilter>
			<categories>
				<li>MeatRaw</li>
			</categories>
			<disallowedThingDefs>
				<li>Meat_Human</li>
				<li>Meat_Megaspider</li>
				<li>Sausage_Raw</li>
				<li MayRequire="Ludeon.Rimworld.Anomaly">Meat_Twisted</li>
			</disallowedThingDefs>
			<thingDefs>
				<li>Aq_RawGarlic</li>
				<li>Aq_RawCarrots</li>
				<li>Aq_BoiledEgg</li>
			</thingDefs>
   </defaultIngredientFilter>
   <ingredients>
			<li>
				<filter>
					<categories>
						<li>MeatRaw</li>
					</categories>
				</filter>
				<count>1.8</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Aq_RawGarlic</li>
						<li>Aq_BoiledEgg</li>
						<li>Aq_RawCarrots</li>
					</thingDefs>
				</filter>
				<count>1.2</count>
			</li>	
  </ingredients>
	<products>
	  <Aq_Meatloaf>3</Aq_Meatloaf>
	</products>
	<workSpeedStat>CookSpeed</workSpeedStat>
      <workSkill>Cooking</workSkill>
       <requiredGiverWorkType>Cooking</requiredGiverWorkType>
      <effectWorking>Cook</effectWorking>
   	 <soundWorking>Recipe_CookMeal</soundWorking>
      <recipeUsers>
        <li>Aq_Oven</li>
        <li>Aq_ElectricOven</li>
      </recipeUsers>
      <skillRequirements>
		<Cooking>6</Cooking>
	</skillRequirements>
      <researchPrerequisites>
			<li>Aq_CookingII</li>
		</researchPrerequisites>   
</RecipeDef>
      

</Defs>