<?xml version="1.0" encoding="utf-8"?>
<Defs>

 <RecipeDef>
		<defName>Aq_MakeColaSyrup</defName>
		<label>make cola syrup</label>
		<description>Make cola syrup by mixing corn and sugar.</description>
		<jobString>Making cola syrup.</jobString>
		<workSpeedStat>DrugCookingSpeed</workSpeedStat>
		<workSkill>Cooking</workSkill>
		<effectWorking>Cook</effectWorking>
		<workAmount>1000</workAmount>
		<soundWorking>Recipe_Brewing</soundWorking>
		<allowMixingIngredients>true</allowMixingIngredients>
		<recipeUsers>
			<li>Brewery</li>	
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>RawCorn</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Aq_Sugar</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>			
			<thingDefs>
				<li>RawCorn</li>
				<li>Aq_Sugar</li>
			</thingDefs>
		</fixedIngredientFilter>
		<defaultIngredientFilter>			
			<thingDefs>
				<li>RawCorn</li>
				<li>Aq_Sugar</li>
			</thingDefs>
		</defaultIngredientFilter>
		<products>
			<Aq_ColaSyrup>20</Aq_ColaSyrup>
		</products>
		<skillRequirements>
			<Cooking>4</Cooking>
		</skillRequirements>
		<researchPrerequisite>Aq_BrewingIII</researchPrerequisite>
	</RecipeDef>
	
