<?xml version="1.0" encoding="utf-8"?>
<Defs>
  
  <RecipeDef>
    <defName>Aq_ChurnStrawberryJam</defName>
    <label>make strawberry jam</label>
    <description>Make strawberry jam using a churn.</description>
    <jobString>Churning jam.</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Brewing</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <workAmount>1200</workAmount>
    <ingredientValueGetterClass>CookingRedux.IngredientValueGetter_NutritionWithExtraIngredient</ingredientValueGetterClass>
    
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RawBerries</li>
          </thingDefs>
        </filter>
        <count>1.2</count>
      </li>
       <li>
            <filter>
               <thingDefs>
                  <li>Aq_Sugar</li>
               </thingDefs>
            </filter>
            <count>2</count>
         </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RawBerries</li>
        <li>Aq_Sugar</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Aq_StrawberryJam>4</Aq_StrawberryJam>
    </products>
    <recipeUsers>
      <li>Aq_Churn</li>
      <li>Aq_ElectricChurn</li>	
    </recipeUsers>
    <skillRequirements>
		<Cooking>4</Cooking>
	</skillRequirements>
    <researchPrerequisite>Aq_JamMaking</researchPrerequisite>
  </RecipeDef>
  
