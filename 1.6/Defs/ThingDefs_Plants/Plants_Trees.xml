<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--=========================== Trees ==============================-->
  <ThingDef ParentName="TreeBase">
    <defName>Aq_TreeAlmond</defName>
    <label>almond tree</label>
    <description>A beautiful deciduous tree cultivated for its fruit, almonds. The sweet almond can be eaten plain or be used as ingredient in desserts. Almonds can be used as fruits or processed into milk.\n\n&lt;color=#E5E54C&gt;Gameplay effect:&lt;/color&gt; All fruit trees take about four times as much space as regular crops, take a long time to grow and produce fruits that can be eaten raw. They aren't destroyed after harvesting but have a limited lifespan and will eventually need to be replanted.</description>
    <graphicData>
      <texPath>Things/Plants/Trees/Aq_AlmondTree</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.15, 0.3, 0.15)</volume>
        <offset>(0,0,-0.38)</offset>
      </shadowData>
    </graphicData>
    <selectable>true</selectable>
    <statBases>
      <Beauty>4</Beauty>
      <BeautyOutdoors>4</BeautyOutdoors>
      <Nutrition>1.25</Nutrition>
    </statBases>
    <minifiedDef IsNull="True" />
    <ingestible />
    <plant>
      <dieIfLeafless>false</dieIfLeafless>
      <growDays>32.51</growDays>
      <visualSizeRange>0.8~2.5</visualSizeRange>
      <sowResearchPrerequisites Inherit="False">
        <li>Aq_Orchard</li>
      </sowResearchPrerequisites>
      <sowMinSkill>6</sowMinSkill>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <fertilityMin>0.7</fertilityMin>
      <mustBeWildToSow>true</mustBeWildToSow>
      <immatureGraphicPath>Things/Plants/Trees/Aq_AlmondTree_Immature</immatureGraphicPath>
      <leaflessGraphicPath>Things/Plants/Trees/Aq_AlmondTree_Leafless</leaflessGraphicPath>
      <harvestWork>800</harvestWork>
      <harvestTag>Standard</harvestTag>
      <harvestYield>50</harvestYield>
      <harvestedThingDef>Aq_Almonds</harvestedThingDef>
      <harvestFailable>true</harvestFailable>
      <harvestMinGrowth>0.51</harvestMinGrowth>
      <harvestAfterGrowth>0.20</harvestAfterGrowth>
    </plant>
  </ThingDef>
  
