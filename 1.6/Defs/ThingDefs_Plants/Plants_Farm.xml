<Defs>
  <!--=========================== Plants ==============================-->
  <ThingDef ParentName="PlantBase">
    <defName>Aq_PlantSaffron</defName>
    <label>saffron plant</label>
    <description>A species of flowering plant of the Crocus genus in the iris family Iridaceae. It is best known for producing the spice saffron from the filaments that grow inside the flower. The harvest takes a long time because it is very delicate.</description>
    <statBases>
      <MaxHitPoints>65</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plants/Aq_Saffron</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>10</pathCost>
    <ingestible />
    <plant>
      <fertilityMin>0.90</fertilityMin>
      <fertilitySensitivity>0.70</fertilitySensitivity>
      <dieIfLeafless>true</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>Aq_RawSaffron</harvestedThingDef>
      <harvestYield>2</harvestYield>
      <harvestWork>500</harvestWork>
      <sowResearchPrerequisites>
        <li>Aq_Spices</li>
      </sowResearchPrerequisites>
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
      <growDays>7</growDays>
      <sowMinSkill>10</sowMinSkill>
      <visualSizeRange>0.4~1</visualSizeRange>
      <wildOrder>2</wildOrder>
      <immatureGraphicPath>Things/Plants/Immature/Aq_Saffron</immatureGraphicPath>
      <purpose>Food</purpose>
    </plant>
  </ThingDef>
  
