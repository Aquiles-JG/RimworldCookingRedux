<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef Name="ShellfishTrapBase" Abstract="True">
    <category>Building</category>
    <thingClass>Building</thingClass>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundImpactDefault>BulletImpact_Wood</soundImpactDefault>
    <selectable>true</selectable>
    <drawerType>MapMeshAndRealTime</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <blockLight>false</blockLight>
    <blockWind>false</blockWind>
    <useHitPoints>true</useHitPoints>
    <repairEffect>Repair</repairEffect>
    <building>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <destroySound>BuildingDestroyed_Soft_Small</destroySound>
    </building>
    <pathCost>60</pathCost>
    <passability>PassThroughOnly</passability>
    <tickerType>Rare</tickerType>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <statBases>
      <SellPriceFactor>0.70</SellPriceFactor>
    </statBases>
    <designationCategory>Production</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <placeWorkers>
		<li>AquilesCore.PlaceWorker_PreventPlacingNearIdenticalBuildings</li>
	</placeWorkers>
    <comps>
      <li Class="VEF.Buildings.CompProperties_ConfigurableSpawner">
        <spawnForbidden>false</spawnForbidden>
        <requiresPower>false</requiresPower>
        <requiresFuel>false</requiresFuel>
        <spawnCount>1</spawnCount>
        <writeTimeLeftToSpawn>false</writeTimeLeftToSpawn>
        <showMessageIfOwned>false</showMessageIfOwned>
      </li>
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <researchPrerequisites>
      <li>Fishing</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- River Trap-->
  <ThingDef ParentName="ShellfishTrapBase">
    <defName>Aq_ShellfishTrap</defName>
    <label>shellfish trap</label>
    <description>A trap designed to catch shellfish and small fishes in rivers.</description>
    <graphicData>
      <texPath>Things/Building/Production/ShellfishTrap</texPath>
    </graphicData>
    <statBases>
      <WorkToBuild>300</WorkToBuild>
      <Mass>5</Mass>
    </statBases>
    <costList>
      <Steel>5</Steel>
    </costList>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>20</costStuffCount>
    <size>(1,1)</size>
    <terrainAffordanceNeeded>MovingFluid</terrainAffordanceNeeded>
  </ThingDef>

  <!-- LISTS: Shallow river-->  
  <VEF.Buildings.ConfigurableSpawnerDef>
    <defName>ShellfishTrap_ShallowRiver</defName>
    <listName>River Shellfish</listName>
    <building>Aq_ShellfishTrap</building>
    <GizmoIcon>UI/River</GizmoIcon>
    <GizmoDescription>GizmoDescriptionSmall</GizmoDescription>
    <GizmoLabel>ShellfishTrapGizmoLabelSmall</GizmoLabel>
    <timeInterval>30000~45000</timeInterval>
    <items>
      <li>Aq_Fish_Crayfish</li>
      <li>Aq_Fish_Crab</li>
      <li>Aq_Fish_Scallop</li>
      <li>Aq_Fish_Eel</li>
      <li>Fish_Salmon</li>
    </items>
    <allowedTerrains>
      <li>WaterMovingShallow</li>
    </allowedTerrains>
  </VEF.Buildings.ConfigurableSpawnerDef>
  <!-- Deep river-->  
  <VEF.Buildings.ConfigurableSpawnerDef>
    <defName>ShellfishTrap_DeepRiver</defName>
    <listName>Deep River Shellfish</listName>
    <building>Aq_ShellfishTrap</building>
    <GizmoIcon>UI/River</GizmoIcon>
    <GizmoDescription>GizmoDescriptionSmall</GizmoDescription>
    <GizmoLabel>ShellfishTrapGizmoLabelSmallTwo</GizmoLabel>
    <timeInterval>30000~60000</timeInterval>
    <items>
      <li>Aq_Fish_Crayfish</li>
      <li>Aq_Fish_Crab</li>
      <li>Aq_Fish_Scallop</li>
      <li>Aq_Fish_Eel</li>
      <li>Fish_Catfish</li>
      <li>Aq_Fish_Sturgeon</li>
    </items>
    <allowedTerrains>
      <li>WaterMovingChestDeep</li>
    </allowedTerrains>
  </VEF.Buildings.ConfigurableSpawnerDef>

  <!-- Ocean Trap--> 
  <ThingDef ParentName="ShellfishTrapBase">
    <defName>Aq_ShellfishTrapDeep</defName>
    <label>ocean shellfish trap</label>
    <description>A trap designed to catch shellfish and small fishes in the ocean.</description>
    <graphicData>
      <texPath>Things/Building/Production/ShellfishTrapDeep</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1.45,1.45)</drawSize>
    </graphicData>
    <statBases>
      <WorkToBuild>300</WorkToBuild>
      <Mass>5</Mass>
    </statBases>
    <costList>
      <Steel>5</Steel>
    </costList>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>20</costStuffCount>
    <size>(1,1)</size>
    <uiIconScale>0.8</uiIconScale>
    <placeWorkers>
      <li>AquilesCore.PlaceWorker_OnOceanWater</li>
    </placeWorkers>
  </ThingDef>

  <!-- LISTS: Shallow ocean-->  
  <VEF.Buildings.ConfigurableSpawnerDef>
    <defName>ShellfishTrap_ShallowOcean</defName>
    <listName>Ocean Shellfish</listName>
    <building>Aq_ShellfishTrapDeep</building>
    <GizmoIcon>UI/Ocean</GizmoIcon>
    <GizmoDescription>GizmoDescriptionSmall</GizmoDescription>
    <GizmoLabel>ShellfishTrapGizmoLabelSmall</GizmoLabel>
    <timeInterval>30000~45000</timeInterval>
    <items>
      <li>Aq_Fish_Anchovy</li>
      <li>Aq_Fish_Kingcrab</li>
      <li>Aq_Fish_Mussel</li>
      <li>Aq_Fish_Octopus</li>
      <li>Aq_Fish_Scallop</li>
      <li>Aq_Fish_Shrimp</li>
    </items>
    <allowedTerrains>
      <li>WaterOceanShallow</li>
    </allowedTerrains>
  </VEF.Buildings.ConfigurableSpawnerDef>
  <!-- Deep ocean--> 
  <VEF.Buildings.ConfigurableSpawnerDef>
    <defName>ShellfishTrap_DeepOcean</defName>
    <listName>Deep Ocean Shellfish</listName>
    <building>Aq_ShellfishTrapDeep</building>
    <GizmoIcon>UI/Ocean</GizmoIcon>
    <GizmoDescription>GizmoDescriptionSmall</GizmoDescription>
    <GizmoLabel>ShellfishTrapGizmoLabelSmallTwo</GizmoLabel>
    <timeInterval>30000~60000</timeInterval>
    <items>
      <li>Fish_Cod</li>
      <li>Aq_Fish_Lobster</li>
      <li>Aq_Fish_Octopus</li>
      <li>Aq_Fish_Shrimp</li>
      <li>Aq_Fish_Squid</li>
      <li>Aq_Fish_Prawn</li>
    </items>
    <allowedTerrains>
      <li>WaterOceanDeep</li>
    </allowedTerrains>
  </VEF.Buildings.ConfigurableSpawnerDef>

</Defs>