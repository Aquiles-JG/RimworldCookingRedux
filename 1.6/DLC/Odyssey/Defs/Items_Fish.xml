<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Fish Meat Base-->
  <ThingDef Name="Aq_FishMeatBase" Abstract="True" ParentName="ResourceBase">
    <graphicData>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.9,0.9)</drawSize>
    </graphicData>
    <ingestible>
      <foodType>Meat</foodType>
      <preferability>RawBad</preferability>
      <tasteThought>AteRawFood</tasteThought>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>RawMeat_Eat</ingestSound>
    </ingestible>
    <statBases>
      <MarketValue>1.5</MarketValue>
      <Mass>0.03</Mass>
      <Nutrition>0.05</Nutrition>
      <MaxHitPoints>60</MaxHitPoints>
      <DeteriorationRate>10</DeteriorationRate>
      <FoodPoisonChanceFixedHuman>0.01</FoodPoisonChanceFixedHuman>
      <Flammability>0.25</Flammability>
    </statBases>
    <thingCategories>
      <li>Aq_Seafood</li>
    </thingCategories>
    <pathCost>14</pathCost>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>2</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="CompProperties_FoodPoisonable" />
    </comps>
    <socialPropernessMatters>true</socialPropernessMatters>
    <tickerType>Rare</tickerType>
  </ThingDef>
  <!-- Fish Meat-->
  <ThingDef ParentName="Aq_FishMeatBase">
    <defName>Aq_RawFishMeat</defName>
    <label>fish meat</label>
    <description>Raw fish meat. Could be eaten "as is," but would probably be better cooked.</description>
    <graphicData>
      <texPath>Things/Items/Resource/FishMeat/RawFishMeat</texPath>
    </graphicData>
  </ThingDef>
  <ThingDef ParentName="Aq_FishMeatBase">
    <defName>Aq_RawSalmonMeat</defName>
    <label>salmon meat</label>
    <description>Raw salmon meat. Could be eaten "as is," but would probably be better cooked.</description>
    <graphicData>
      <texPath>Things/Items/Resource/FishMeat/RawSalmonMeat</texPath>
    </graphicData>
    <statBases>
      <MarketValue>2</MarketValue>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="Aq_FishMeatBase">
    <defName>Aq_SalmonRoe</defName>
    <label>salmon roe</label>
    <description>Salmon roe caught from salmon. It can be used as an ingredient in cooking, and it is delicious to eat as it is, but it's best made into sushi.</description>
    <graphicData>
      <texPath>Things/Items/Resource/FishMeat/SalmonRoe</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <ingestible>
      <preferability>RawBad</preferability>
      <tasteThought>Aq_AteSalmonRoe</tasteThought>
    </ingestible>
    <statBases>
      <MarketValue>3.5</MarketValue>
      <DeteriorationRate>20</DeteriorationRate>
    </statBases>
    <thingCategories Inherit="False">
      <li>AnimalProductRaw</li>
    </thingCategories>
  </ThingDef>
  <ThingDef ParentName="Aq_FishMeatBase">
    <defName>Aq_RawMarlinMeat</defName>
    <label>swordfish meat</label>
    <description>Raw swordfish meat. Could be eaten "as is," but would probably be better cooked.</description>
    <graphicData>
