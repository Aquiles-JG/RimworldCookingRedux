  <ThingDef ParentName="MealCooked">
    <defName>Aq_Nigiri</defName>
    <label>sushi</label>
    <description>Nigiri sushi consists of an oblong mound of sushi rice that the chef presses between the palms of the hands to form an oval-shaped ball, and a topping (the neta) draped over the ball.</description>
    <graphicData>
      <texPath>Things/Items/Nigiri</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>18.2</MarketValue>
      <Nutrition>0.9</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealFine</preferability>
      <tasteThought>Aq_AteFineSushi</tasteThought>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>Aq_AteFineSushi</hediffDef>
          <severity>0.25</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <tradeTags>
      <li>Aq_Foods</li>
    </tradeTags>
  </ThingDef>
