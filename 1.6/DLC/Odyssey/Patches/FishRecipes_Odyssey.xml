    <value>
      <li>Fishing</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/RecipeDef[defName = "Aq_CookHotPot"]/fixedIngredientFilter/categories</xpath>
    <value>
      <li>Fish</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/RecipeDef[defName = "Aq_CookHotPot"]/defaultIngredientFilter/categories</xpath>
    <value>
      <li>Fish</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/RecipeDef[defName = "Aq_CookHotPot"]/ingredients/li/filter/categories</xpath>
    <value>
      <li>Fish</li>
    </value>
  </Operation>
</Patch>
