<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/RecipeDef [defName = "CookMealSurvivalBulk" or defName = "Make_Kibble" or defName = "Make_Pemmican" or defName = "Make_PemmicanBulk"]/ingredients/li[1]/filter/categories</xpath>
        <value>
          <li>Aq_Seafood</li>
        </value>
      </li>
    </operations>
  </Operation>
  
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Rimworld Races: Dwarves</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/RecipeDef[defName="Aq_MakeFishFood"]/defaultIngredientFilter/disallowedThingDefs</xpath>
          <value>
            <li>Aq_RawChaga</li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
