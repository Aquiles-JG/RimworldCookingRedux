<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Aquiles Alchemy</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[@Name = "ShellfishTrapBase"]/researchPrerequisites</xpath>
          <value>
            <researchPrerequisites>
              <li>Aq_FishingTraps</li>
            </researchPrerequisites>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
