<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Aquiles Alchemy</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="Aq_ShellfishTrap"]/costList</xpath>
          <value>
            <costList>
              <Steel>3</Steel>
              <Aq_Tar>2</Aq_Tar>
            </costList>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="Aq_ShellfishTrapDeep"]/costList</xpath>
          <value>
            <Aq_Tar>5</Aq_Tar>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
