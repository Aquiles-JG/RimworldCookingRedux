<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Aquiles Alchemy</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[@Name="ShellfishTrapBase"]/costList</xpath>
          <value>
            <Aq_Tar>5</Aq_Tar>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="Aq_AquacultureBasin"]/comps/li[@Class="PipeSystem.CompProperties_AdvancedResourceProcessor"]/processes</xpath>
          <value>
            <li>BreedingSalmonProcess</li>
            <li>BreedingSturgeonProcess</li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
