<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Brewing Expanded</li>
        </mods>
        <match Class="PatchOperationSequence">
        
            <operations>
                <li Class="PatchOperationRemove">
                    <xpath>/Defs/ThingDef[defName="VBE_GourmetCocktail"]</xpath>
                </li>
                
                <li Class="PatchOperationAdd">
                  	<success>Always</success>
                    <xpath>/Defs/ThingDef[defName="Beer"]/thingCategories</xpath>
                    <value>
                        <li>VBE_DrinksSimpleSpirits</li>
                    </value>
                </li>
                <li Class="PatchOperationFindMod">
                    <mods>
                        <li>Vanilla Factions Expanded - Vikings</li>
                    </mods>
                    <match Class="PatchOperationSequence">
                    
                        <operations>
                            <li Class="PatchOperationAdd">
                                <success>Always</success>
                                <xpath>/Defs/ThingDef[defName="VFEV_Mead"]/thingCategories</xpath>
                                <value>
                                    <li>VBE_DrinksLuxurySpirits</li>
                                </value>
                            </li>
                        </operations>
                    </match>
                </li>
                <li Class="PatchOperationFindMod">
                    <mods>
                        <li>Vanilla Factions Expanded - Medieval</li>
                    </mods>
                    <match Class="PatchOperationSequence">
                   
                        <operations>
                            <li Class="PatchOperationAdd">
                                <success>Always</success>
                                <xpath>/Defs/ThingDef[defName="VFEM_Wine"]/thingCategories</xpath>
                                <value>
                                    <li>VBE_DrinksLuxurySpirits</li>
                                </value>
                            </li>
                        </operations>
                    </match>
                </li>
                <li Class="PatchOperationFindMod">
                    <mods>
                        <li>Vanilla Factions Expanded - Settlers</li>
                    </mods>
                    <match Class="PatchOperationSequence">
                       
                        <operations>
                            <li Class="PatchOperationAdd">
                                <success>Always</success>
                                <xpath>/Defs/ThingDef[defName="Chemshine"]/thingCategories</xpath>
                                <value>
                                    <li>VBE_DrinksLuxurySpirits</li>
                                </value>
                            </li>
                        </operations>
                    </match>
                </li>

            </operations>
        </match>
	</Operation>
</Patch>