			<xpath>Defs/ThingDef[defName = "RawCrabMeat"]/ingestible/preferability</xpath>
			<value>
				<preferability>RawBad</preferability>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationRemove">
           <xpath>/Defs/RecipeDef[defName="CookMealGrilledFish" or defName="CookMealGrilledFishBulk"]</xpath>
        </Operation>
        
        <Operation Class="PatchOperationRemove">
           <xpath>/Defs/ThingDef[defName="GrilledTinyFish"]</xpath>
        </Operation>
        
       
      
</Patch>

