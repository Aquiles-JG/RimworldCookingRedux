<?xml version="1.0" encoding="utf-8"?>
<Defs>
 
 <RecipeDef>
    <defName>Aq_MakeBarleySoup</defName>
    <label>make barley soup</label>
    <description>Make four servings of barley soup.</description>
    <jobString>Making barley soup.</jobString>
    <workAmount>1200</workAmount> 
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass> 
   	<defaultIngredientFilter>
			<thingDefs>
				<li>RawFungus</li>
				<li>Aq_RawCarrots</li>
				<li>Aq_RawBarley</li>
			</thingDefs>
   	</defaultIngredientFilter>
   	<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>RawFungus</li>
						<li>Aq_RawCarrots</li>
					</thingDefs>
				</filter>
				<count>1.6</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Aq_RawBarley</li>
					</thingDefs>
				</filter>
				<count>0.4</count>
			</li>
  	</ingredients>
  	<fixedIngredientFilter>
			<thingDefs>
				<li>RawFungus</li>
				<li>Aq_RawCarrots</li>
				<li>Aq_RawBarley</li>
			</thingDefs>
  	</fixedIngredientFilter>	
	<products>
	  <Aq_BarleySoup>4</Aq_BarleySoup>
	</products>
	<workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
   	<soundWorking>Recipe_CookMeal</soundWorking>
	<recipeUsers>
        <li>ElectricStove</li>
	    <li>FueledStove</li>
    </recipeUsers>
    <skillRequirements>
		<Cooking>4</Cooking>
	</skillRequirements>
    <researchPrerequisites>
		<li>Dwarves_Cooking</li>
		<li>Aq_SoupMaking</li>
	</researchPrerequisites>
  </RecipeDef>
  
    <RecipeDef>
	<defName>Aq_CookBarleyPorridge</defName>
	<label>cook porridge</label>
	<description>Cook four porridges.</description>
	<jobString>Cooking porridge.</jobString>
    <workAmount>1200</workAmount>
	<allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
	<fixedIngredientFilter>
			<thingDefs>
				<li>Aq_RawBarley</li>
				<li>Milk</li>
				<li>Aq_Honey</li>
				<li>RawBerries</li>
			</thingDefs>
	</fixedIngredientFilter>
	<defaultIngredientFilter>		
		<thingDefs>
			<li>RawPotatoes</li>
			<li>Milk</li>
			<li>Aq_Honey</li>
			<li>RawBerries</li>
		</thingDefs>	
   </defaultIngredientFilter>
   <ingredients>
   			<li>
				<filter>
					<thingDefs>
						<li>Aq_RawBarley</li>
					</thingDefs>
				</filter>
				<count>0.4</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Milk</li>
						<li>Aq_Honey</li>
						<li>RawBerries</li>
					</thingDefs>
				</filter>
				<count>1.6</count>
			</li>	
  </ingredients>
	<products>
	  <Aq_BarleyPorridge>4</Aq_BarleyPorridge>
	</products>
	<workSpeedStat>CookSpeed</workSpeedStat>
      <workSkill>Cooking</workSkill>
       <requiredGiverWorkType>Cooking</requiredGiverWorkType>
      <effectWorking>Cook</effectWorking>
   	 <soundWorking>Recipe_CookMeal</soundWorking>
      <recipeUsers>
        <li>FueledStove</li>
        <li>ElectricStove</li>
        <li>Campfire</li>
      </recipeUsers>
      <skillRequirements>
		<Cooking>4</Cooking>
	</skillRequirements>
      <researchPrerequisites>
			<li>Dwarves_Cooking</li>
	  </researchPrerequisites>
	   </RecipeDef>
	   
<RecipeDef>
	<defName>Aq_MakeTrufflePasta</defName>
	<label>make truffle pasta</label>
	<description>Make two servings of pasta with truffle sauce.</description>
	<jobString>Making truffle pasta.</jobString>
	<workAmount>3200</workAmount>
	<allowMixingIngredients>true</allowMixingIngredients>
	<ingredientValueGetterClass>CookingRedux.IngredientValueGetter_NutritionWithExtraIngredient</ingredientValueGetterClass>
	<recipeUsers>
        <li>FueledStove</li>
        <li>ElectricStove</li>
    </recipeUsers>
	<fixedIngredientFilter>
			<thingDefs>
				<li>Aq_Pasta</li>
				<li>Aq_RawTruffle</li>
				<li>Aq_RawCarrots</li>
				<li>Aq_RawGarlic</li>
				<li>Aq_Butter</li>
				<li>Aq_Cheese</li>
				<li>Aq_VegCheese</li>
			</thingDefs>
	</fixedIngredientFilter>
	<defaultIngredientFilter>
			<thingDefs>
				<li>Aq_Pasta</li>
				<li>Aq_RawTruffle</li>
				<li>Aq_RawCarrots</li>
				<li>Aq_RawGarlic</li>
				<li>Aq_Cheese</li>
			</thingDefs>
			<disallowedThingDefs>
				<li>Aq_Butter</li>
				<li>Aq_VegCheese</li>
			</disallowedThingDefs>		
   	</defaultIngredientFilter>
   	<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Aq_Pasta</li>
					</thingDefs>
				</filter>
				<count>1.8</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Aq_RawCarrots</li>
						<li>Aq_RawGarlic</li>
						<li>Aq_Butter</li>
						<li>Aq_Cheese</li>
						<li>Aq_VegCheese</li>
					</thingDefs>
				</filter>
				<count>2.1</count>  <!-- Not 2.2 for the cheese (0.3x7=2.1)-->
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Aq_RawTruffle</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>		
   </ingredients>
	<products>
	  <Aq_TrufflePasta>2</Aq_TrufflePasta>
	</products>
	<workSpeedStat>CookSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
   	<soundWorking>Recipe_CookMeal</soundWorking>
    <skillRequirements>
     	<Cooking>8</Cooking>
    </skillRequirements> 
    <researchPrerequisites>
		<li>Aq_CookingIII</li>
	</researchPrerequisites>  
</RecipeDef>

	<RecipeDef>
		<defName>Aq_MakeCamomileTea</defName>
		<label>make camomile infusion</label>
		<description>Make a pleasing infusion prepared by steeping a bag of camomile flowers in boiling water.</description>
		<jobString>Making camomile infusion.</jobString>
		<workSkill>Cooking</workSkill>
		<workSpeedStat>CookSpeed</workSpeedStat>
		<workAmount>600</workAmount>
		<effectWorking>Cook</effectWorking>
		<soundWorking>Recipe_Brewing</soundWorking>
		<allowMixingIngredients>true</allowMixingIngredients>	
		<recipeUsers>
			<li>Campfire</li>
			<li>ElectricStove</li>	
			<li>FueledStove</li>	
			<li>Aq_CoffeeMachine</li>				
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Aq_CamomileLeaves</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>			
			<thingDefs>
				<li>Aq_CamomileLeaves</li>	
			</thingDefs>
		</fixedIngredientFilter>
		<defaultIngredientFilter>			
			<thingDefs>
				<li>Aq_CamomileLeaves</li>
			</thingDefs>
		</defaultIngredientFilter>
		<products>
			<Aq_CamomileTea>4</Aq_CamomileTea>
		</products>
		<researchPrerequisite>Aq_BrewingII</researchPrerequisite>	
	</RecipeDef>
	
