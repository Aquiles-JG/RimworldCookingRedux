<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<Operation Class="PatchOperationFindMod">
    <mods>
        <li>Rimworld Races: Humanoids</li>
    </mods>
    <match Class="PatchOperationSequence">
       
        <operations>
        
            <li Class="PatchOperationAdd">
				<xpath>Defs/RecipeDef[defName="Aq_MakeBarleySoup" or defName="Aq_CookBarleyPorridge"]/recipeUsers</xpath>
				<value>
					<li>Aq_Cauldron</li>
				</value>
			</li>
           
        </operations>
    </match>
</Operation>

</Patch>