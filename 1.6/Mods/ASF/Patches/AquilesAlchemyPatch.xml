<?xml version="1.0" encoding="utf-8" ?>
<Patch>

 <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Aquiles Alchemy</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="Aq_StoneCellar"]/costList</xpath>
          <value>
              <Aq_ComponentMedieval>1</Aq_ComponentMedieval>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="Aq_SaltedBarrel"]/costList</xpath>
          <value>
            <Aq_Tar>5</Aq_Tar>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>