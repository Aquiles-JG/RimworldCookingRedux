<Defs>


	<ThingDef ParentName="MealCooked">
      <defName>Aq_ChocolateCake</defName>
      <label>chocolate cherry cake</label>
      <description>A slice of tasteful chocolate cherry cake. It helps with toxic sensitivity as well as decreases hunger rate and the mental break threshold for a short period of time.</description>
    <graphicData>
      <texPath>Things/Items/Cakes/ChocolateCake</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
      <statBases>
         <DeteriorationRate>7.5</DeteriorationRate>
         <MarketValue>21.8</MarketValue>
         <Beauty>0</Beauty>
         <Nutrition>0.7</Nutrition>
         <Mass>0.44</Mass>
      </statBases>
      <ingestible>
         <preferability>MealLavish</preferability>
         <joy>0.6</joy>
         <ingestEffect>EatVegetarian</ingestEffect>
         <ingestSound>Meal_Eat</ingestSound>
      	 <joyKind>Gluttonous</joyKind>
      	 <tasteThought>Aq_AteChocolateCake</tasteThought>
      	 <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      	 <outcomeDoers>
			<li Class="IngestionOutcomeDoer_GiveHediff">
		 	<hediffDef>Aq_AteChocolateCake</hediffDef>
		 	<severity>0.25</severity>
			</li>
		</outcomeDoers>
      </ingestible>
      <tradeTags>
      		<li>Aq_Foods</li>
    	</tradeTags> 
   </ThingDef>
   
