<?xml version="1.0" encoding="utf-8" ?>
<Patch>
 
  

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Reel's Expanded Storage</li>
        </mods>
       
            <match Class="PatchOperationSequence">
              
                <operations>
                   
                <li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="ReelStorageWineRack"]/building/fixedStorageSettings/filter/categories</xpath>
					<value>
						<li>Aq_DrinksAlcoholic</li>
					</value>
				</li>
				
				  <li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="ReelStorageWineRack"]/researchPrerequisites/li[text()="Brewing"]</xpath>
					<value>
						<li>Aq_WineMaking</li>
					</value>
				</li>
				
                </operations>
            </match>
    </Operation>


</Patch>