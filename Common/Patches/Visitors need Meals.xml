<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	
<!-- Trying to make visitors not eat my food-->
		
<Operation Class="PatchOperationAdd">
	<xpath>/Defs/PawnKindDef[@Name = "MercenaryBase" or @Name="OutlanderBase" or @Name="PirateBase" or @Name="ImperialFighterBase"]</xpath>
	<value>
		<invFoodDef>MealSurvivalPack</invFoodDef>
	</value>
</Operation>

</Patch>