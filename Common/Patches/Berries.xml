<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="RawBerries"]</xpath>
    <value>
      <thingCategories Inherit="False">
        <li>Aq_Fruit</li>
      </thingCategories>
    </value>
  </Operation>
  
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[@Name="PlantStrawberry"]/plant/harvestedThingDef</xpath>
    <value>
      <harvestedThingDef>Aq_RawStrawberries</harvestedThingDef>
    </value>
  </Operation>
</Patch>
