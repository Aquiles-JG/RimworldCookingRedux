<?xml version="1.0" encoding="UTF-8"?>
<Patch>

<!-- This patch works only for vanilla. Gloomy Furniture and Apothecary mods patched in different files. Any mod that adds cooking benches might need its own patch too. -->

  <Operation Class="PatchOperationSequence">
    <operations>
     
      <li Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="MealSimple"]</xpath>
        <value>
          <ThingDef>
            <defName>MealSimple</defName>
            <label>dummy</label>
            <thingClass>ThingWithComps</thingClass>
          </ThingDef>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="MealFine"]</xpath>
        <value>
          <ThingDef>
            <defName>MealFine</defName>
            <label>dummy</label>
            <thingClass>ThingWithComps</thingClass>
          </ThingDef>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="MealLavish"]</xpath>
        <value>
          <ThingDef>
            <defName>MealLavish</defName>
            <label>dummy</label>
            <thingClass>ThingWithComps</thingClass>
          </ThingDef>
        </value>
      </li>
       <li Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="MealFine_Veg"]</xpath>
        <value>
          <ThingDef>
            <defName>MealFine_Veg</defName>
            <label>dummy</label>
            <thingClass>ThingWithComps</thingClass>
          </ThingDef>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="MealLavish_Veg"]</xpath>
        <value>
          <ThingDef>
            <defName>MealLavish_Veg</defName>
            <label>dummy</label>
            <thingClass>ThingWithComps</thingClass>
          </ThingDef>
        </value>
      </li>
       <li Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="MealFine_Meat"]</xpath>
        <value>
          <ThingDef>
            <defName>MealFine_Meat</defName>
            <label>dummy</label>
            <thingClass>ThingWithComps</thingClass>
          </ThingDef>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="MealLavish_Meat"]</xpath>
        <value>
          <ThingDef>
            <defName>MealLavish_Meat</defName>
            <label>dummy</label>
            <thingClass>ThingWithComps</thingClass>
          </ThingDef>
        </value>
      </li>
      
      <li Class="PatchOperationRemove">
        <xpath>/Defs/RecipeDef[defName="CookMealFine_Veg" or defName="CookMealFine_Meat" or defName="CookMealFineBulk_Veg" or defName="CookMealFineBulk_Meat" or defName="CookMealLavish_Veg" or defName="CookMealLavish_Meat" or defName="CookMealLavishBulk_Veg" or defName="CookMealLavishBulk_Meat"]</xpath>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/RecipeDef[defName="CookMealSimple"]</xpath>
        <value>
          <RecipeDef>
            <defName>CookMealSimple</defName>
            <label>dummy</label>
          </RecipeDef>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/RecipeDef[defName="CookMealSimpleBulk"]</xpath>
        <value>
          <RecipeDef>
            <defName>CookMealSimpleBulk</defName>
            <label>dummy</label>
          </RecipeDef>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/RecipeDef[defName="CookMealFine"]</xpath>
        <value>
          <RecipeDef>
            <defName>CookMealFine</defName>
            <label>dummy</label>
          </RecipeDef>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/RecipeDef[defName="CookMealFineBulk"]</xpath>
        <value>
          <RecipeDef>
            <defName>CookMealFineBulk</defName>
            <label>dummy</label>
          </RecipeDef>
        </value>
      </li>
       <li Class="PatchOperationReplace">
        <xpath>/Defs/RecipeDef[defName="CookMealLavish"]</xpath>
        <value>
          <RecipeDef>
            <defName>CookMealLavish</defName>
            <label>dummy</label>
          </RecipeDef>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/RecipeDef[defName="CookMealLavishBulk"]</xpath>
        <value>
          <RecipeDef>
            <defName>CookMealLavishBulk</defName>
            <label>dummy</label>
          </RecipeDef>
        </value>
      </li>
      
      <li Class="PatchOperationAdd">
        <xpath>/Defs/RecipeDef[defName="CookMealSurvivalBulk" or defName="Make_Pemmican" or defName="Make_PemmicanBulk"]</xpath>
        <value>
          <recipeUsers>
          	<li>FueledStove</li>
          	<li>ElectricStove</li>
          </recipeUsers>
        </value>
      </li>
      
      <li Class="PatchOperationRemove">
        <xpath>/Defs/ThingDef[defName="ElectricStove" or defName="FueledStove" or defName="Campfire"]/recipes[li="CookMealSimple" or li="CookMealFine" or li="CookMealFine_Veg" or li="CookMealFine_Meat" or li="CookMealLavish" or li="CookMealLavish_Veg" or li="CookMealLavish_Meat" or li="CookMealSimpleBulk" or li="CookMealFineBulk" or li="CookMealFineBulk_Veg" or li="CookMealFineBulk_Meat" or li="CookMealLavishBulk" or li="CookMealLavishBulk_Veg" or li="CookMealLavishBulk_Meat" or li="CookMealSurvival"]</xpath>
      </li>
      
     <li Class="PatchOperationRemove">
        <xpath>/Defs/RecipeDef[defName="CookMealSurvival"]</xpath>
      </li>
      
          
    </operations>
  </Operation>
  
    <!-- Changes for making Pemmican-->
       <Operation Class="PatchOperationAdd">
        <xpath>/Defs/RecipeDef[defName="Make_Pemmican" or defName="Make_PemmicanBulk"]/fixedIngredientFilter/disallowedCategories</xpath>
        <value>
         	<li>Aq_Condiments</li>
        </value>
      </Operation>
  
</Patch>