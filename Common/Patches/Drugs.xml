<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	
<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="Beer"]</xpath>
		<value>
			<thingCategories Inherit="False"><li>Aq_DrinksAlcoholic</li></thingCategories>
		</value>
</Operation>

<Operation Class="PatchOperationReplace">
		<xpath>/Defs/ThingDef[defName="Wort"]/thingCategories</xpath>
		<value>
			<thingCategories><li>Aq_Musts</li></thingCategories>
		</value>
</Operation>

<Operation Class="PatchOperationReplace">
		<xpath>/Defs/ThingDef[defName = "PsychiteTea"]/recipeMaker/recipeUsers</xpath>
		<value>
			<recipeUsers>
				<li>DrugLab</li>
			</recipeUsers>
		</value>
</Operation>

</Patch>