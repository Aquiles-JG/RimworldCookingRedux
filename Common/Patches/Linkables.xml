<?xml version="1.0" encoding="utf-8" ?>
<Patch>


  <Operation Class="PatchOperationConditional">
	<xpath>Defs/ThingDef[defName = "FueledStove" or defName="ElectricStove"]/comps/li[contains(@Class,'CompProperties_AffectedByFacilities')]/linkableFacilities</xpath>
    <nomatch Class="PatchOperationAdd">
  		<xpath>Defs/ThingDef[defName = "FueledStove" or defName="ElectricStove"]/comps</xpath>
      <value>
      		<li Class="CompProperties_AffectedByFacilities">
        		<linkableFacilities>
          			<li>Aq_CookingTools</li>
        		</linkableFacilities>
      		</li>
      </value>
    </nomatch>
	<match Class="PatchOperationAdd">
  		<xpath>Defs/ThingDef[defName = "FueledStove" or defName="ElectricStove"]/comps/li[contains(@Class,'CompProperties_AffectedByFacilities')]/linkableFacilities</xpath>
      	<value>
          	<li>Aq_CookingTools</li>
      	</value>
	</match>
  </Operation>
  

    <Operation Class="PatchOperationAdd">
  		<xpath>Defs/ThingDef[defName = "TableButcher"]/comps/li[contains(@Class,'CompProperties_AffectedByFacilities')]/linkableFacilities</xpath>
      	<value>
          	<li>Aq_CookingTools</li>
      	</value>
    </Operation>
  

</Patch>